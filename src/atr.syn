-- atr.syn — the Atril command line. It talks to the daemon of this machine and starts it when it is
-- not running. Installed, it is atr.exe next to atrild.exe. From the source, the launchers
-- cli/atr.cmd and cli/atr set ATRIL_HOME and the daemon runs as `synsema serve src/atrild.syn`.
--
--   atr open [session] [--new]     the window (starts the daemon if needed); with a session, on that tab.
--                                  A window already open shows it instead, unless --new
--   atr run [--name N] [--cwd D] [--open] [--attach] [cmd args…]
--                                  a new session (your shell without cmd), in this folder unless --cwd;
--                                  it outlives every window. --attach shows it in this terminal
--   atr claude | codex | … [args]  that agent in a new session here, shown in this terminal (over SSH
--                                  too): Ctrl+] lets go of it and it keeps running; the app sees it
--   atr attach [session]           a session in this terminal; Ctrl+] lets go of it. Without one: the
--                                  only one running, or the list of atr top
--   atr top                        every session of this machine in this terminal, live: the arrows
--                                  choose, Enter goes in, Ctrl+] comes back, n a new shell, x ends one.
--                                  `atr` over SSH (no screen) shows it too
--   atr ls [--json]                the sessions of this machine
--   atr name <session> <title…>    give a session a title: what you do there, to find it later
--   atr kill <session>             end the program of a session (id, name or pid)
--   atr rm <session>               forget a session that already ended
--   atr url [session]              the address of the window with its key (for a browser elsewhere,
--                                  through `ssh -L 7172:127.0.0.1:7171 <server>`: change the port)
--   atr up | atr down              start the daemon | stop it (and every session with it)
--   atr pair                       a QR for your phone: scanned, the phone opens this machine's window
--                                  through the relay, encrypted end to end (one use, 5 minutes)
--   atr devices [rm <id>]          the paired phones; rm cuts one at once
--   atr relay [use <address>|use synsema]
--                                  the relay the phones come through, and how long it takes to answer
--                                  from here; `use` moves to another one (yours: see src/relay.syn) and
--                                  the phones connected now come along

require net("127.0.0.1:7171")
require file.read("~/.atril/*")
require env("ATRIL_HOME")
require env("USERPROFILE")
require env("HOME")
require env("DISPLAY")
require env("WAYLAND_DISPLAY")
require stdout
require time
require exec("powershell")
require exec("sh")
require exec("open")
require exec("xdg-open")
require stdin
require file.read(".")      -- the folder you are in: where `atr run` and `atr claude` start

use "./window.syn" as window
use "./qr.syn" as qr

let BASE be "http://127.0.0.1:7171"
let WIN be platform()["os"] == "windows"
let VERSION be "0.4.0"

task say(t)
    print(t)

task fail(t)
    print("atr: " + t)
    exit(1)

task conf()
    try
        give json_decode(read_file("~/.atril/daemon.json"))
    recover e
        give nothing

task headers(c)
    give {"Authorization": "Bearer " + c["token"]}

-- the daemon answers with this machine's key
task alive()
    let c be conf()
    when c == nothing
        give false
    try
        let r be http_get(BASE + "/api/info", headers(c), nothing, 2)
        give ok of r
    recover e
        give false

task up()
    when alive()
        give conf()
    let home be env("ATRIL_HOME", "")
    let exe be self_path()
    -- from the source: the engine serves src/atrild.syn; installed: atrild next to this binary.
    -- --background: started from here, the daemon opens no window of its own
    let dir be home + "/src"
    let cmd be exe
    let cmd_args be ["serve", "atrild.syn", "--", "--background"]
    when home == ""
        set dir to regex_replace(replace(exe, "\\", "/"), "/[^/]*$", "")
        set cmd to dir + (when WIN then "/atrild.exe" otherwise "/atrild")
        set cmd_args to ["--background"]
    when WIN
        -- no -Redirect*: with it the daemon inherits this pipe and `run` would wait for it forever
        let q be (t) => "'" + replace(t, "'", "''") + "'"
        let al be when length(cmd_args) == 0 then "" otherwise " -ArgumentList " + join(apply(cmd_args, q), ",")
        run("powershell", ["-NoProfile", "-Command", "Start-Process -WindowStyle Hidden -FilePath " + q(cmd) + al + " -WorkingDirectory " + q(dir)])
    otherwise
        run("sh", ["-c", "mkdir -p \"$HOME/.atril\" && cd \"$1\" && shift && nohup \"$@\" >\"$HOME/.atril/daemon.log\" 2>&1 &", "sh", dir, cmd] + cmd_args)
    let tries be 0
    while not alive() and tries < 40
        sleep(0.25)
        set tries to tries + 1
    when not alive()
        fail("the daemon did not start; look at ~/.atril/daemon.log")
    give conf()

task api(method, path, body)
    let c be up()
    let r be nothing
    when method == "GET"
        set r to http_get(BASE + path, headers(c))
    otherwise when method == "POST"
        set r to http_post(BASE + path, body, headers(c))
    otherwise
        set r to http_delete(BASE + path, headers(c))
    when not (ok of r)
        let j be json of r
        fail(when j != nothing then text(get(j, "error", body of r)) otherwise body of r)
    give json of r

task url_of(ref)
    let c be up()
    give BASE + "/#t=" + c["token"] + (when ref == nothing then "" otherwise "&s=" + ref)

-- a window is already open: it shows the session itself, and no second window appears
task show_in_open_window(ref)
    try
        let r be api("POST", "/api/show", {"ref": ref})
        give r["shown"]
    recover e
        give false

task open_window(ref, fresh)
    when not fresh and show_in_open_window(ref)
        say("Atril ya estaba abierto: " + (when ref == nothing then "está en esa ventana" otherwise "abrí " + ref + " ahí") + ". (atr open --new abre otra ventana)")
        give nothing
    let url be url_of(ref)
    when not WIN and platform()["os"] != "macos" and env("DISPLAY", "") == "" and env("WAYLAND_DISPLAY", "") == ""
        -- over SSH: the list here, and the window's address for your computer
        when ref == nothing
            when top()
                give nothing
        say("no screen here. From your computer:")
        say("  ssh -L 7172:127.0.0.1:7171 <this server>")
        say("  then open " + replace(url, ":7171/", ":7172/"))
        give nothing
    window.open_url(url)

task ago(ts)
    let d be now() - ts
    when d < 60
        give text(floor(d)) + "s"
    when d < 3600
        give text(floor(d / 60)) + "m"
    when d < 86400
        give text(floor(d / 3600)) + "h"
    give text(floor(d / 86400)) + "d"

task pad(t, n)
    let s be text(t)
    while length(s) < n
        set s to s + " "
    give s

task list(as_json)
    let items be api("GET", "/api/sessions", nothing)["items"]
    when as_json
        say(json_encode(items))
        give nothing
    when length(items) == 0
        say("no sessions. `atr run` opens one.")
    otherwise
        say(pad("ID", 6) + pad("NAME", 20) + pad("PID", 8) + pad("STATE", 12) + pad("AGE", 6) + "COMMAND")
    each s in items
        let st be s["activity"]
        when s["status"] == "exited"
            set st to "exited " + text(s["exit_code"])
        otherwise when s["bell"]
            set st to "needs you"
        say(pad(s["id"], 6) + pad(s["name"], 20) + pad(s["pid"], 8) + pad(st, 12) + pad(ago(s["started"]), 6) + s["cmd"] + " " + join(s["args"], " "))
    -- agents running here outside Atril: seen, not attachable
    let out be api("GET", "/api/outside", nothing)["items"]
    when length(out) > 0
        say("")
        say("outside Atril (their screen is in another terminal; start them with `atr <agent>` to have them here):")
        each o in out
            say("  " + pad(o["kind"], 12) + "pid " + pad(o["pid"], 8) + (when o["cwd"] == nothing then "" otherwise o["cwd"]))

-- ---- a session in this terminal: keys go to it, its screen comes here, Ctrl+] lets go

let ESC be decode(bytes([27]), "utf8")
let KEYS be {"enter": "\r", "tab": "\t", "backtab": ESC + "[Z", "backspace": decode(bytes([127]), "utf8"),
    "delete": ESC + "[3~", "insert": ESC + "[2~", "escape": ESC, "up": ESC + "[A", "down": ESC + "[B",
    "right": ESC + "[C", "left": ESC + "[D", "home": ESC + "[H", "end": ESC + "[F", "pageup": ESC + "[5~",
    "pagedown": ESC + "[6~", "f1": ESC + "OP", "f2": ESC + "OQ", "f3": ESC + "OR", "f4": ESC + "OS",
    "f5": ESC + "[15~", "f6": ESC + "[17~", "f7": ESC + "[18~", "f8": ESC + "[19~", "f9": ESC + "[20~",
    "f10": ESC + "[21~", "f11": ESC + "[23~", "f12": ESC + "[24~"}

-- what a key event types into a terminal
task typed(ev)
    when ev["type"] == "paste"
        give ev["text"]
    let out be get(KEYS, get(ev, "key", ""), "")
    when get(ev, "key", "") == "char"
        set out to ev["text"]
        when get(ev, "ctrl", false) and length(out) == 1
            let i be index_of("abcdefghijklmnopqrstuvwxyz", lower(out))
            when i != nothing
                set out to decode(bytes([i + 1]), "utf8")
            otherwise when out in ["@", " ", "2"]
                set out to decode(bytes([0]), "utf8")
            -- a terminal sends Ctrl+3..7 with the codes of Ctrl+[ \ ] ^ _ (27..31): read back as digits
            otherwise when out in ["3", "4", "5", "6", "7"]
                set out to decode(bytes([index_of("34567", out) + 27]), "utf8")
            otherwise when out in ["[", "\\", "^", "_"]
                set out to decode(bytes([index_of("[\\]^_", out) + 27]), "utf8")
    when get(ev, "alt", false) and out != ""
        set out to ESC + out
    give out

-- what a program may leave on when you let go of it: colors, a hidden cursor, mouse reports,
-- bracketed paste, application keys, focus reports
let RESET be ESC + "[0m" + ESC + "[?25h" + ESC + "[?1l" + ESC + "[?1000l" + ESC + "[?1002l" + ESC + "[?1003l" + ESC + "[?1006l" + ESC + "[?2004l" + ESC + "[?1004l"

-- the session on screen until it ends, the link drops or Ctrl+]; gives why it stopped
task attach_in(term, ref)
    let c be up()
    let ws be ws_connect("ws://127.0.0.1:7171/api/sessions/" + ref + "/attach", headers(c))
    let size be term_size(term)
    ws_send(ws, json_encode({"t": "r", "cols": size["cols"], "rows": size["rows"]}))
    term_write(term, ESC + "[2J" + ESC + "[H")
    let why be "soltaste"
    let going be true
    while going
        let ev be select({"keys": term, "ws": ws}, 30)
        when ev != nothing and ev["name"] == "ws"
            when ev["type"] == "close"
                set why to "se cortó la conexión con Atril"
                set going to false
            otherwise when ev["type"] == "text"
                let m be json_decode(ev["data"], nothing)
                when m != nothing and m["t"] == "o"
                    term_write(term, m["d"])
                otherwise when m != nothing and m["t"] == "exit"
                    set why to "terminó (código " + text(m["code"]) + ")"
                    set going to false
                otherwise when m != nothing and m["t"] == "error"
                    set why to m["error"]
                    set going to false
        otherwise when ev != nothing and ev["name"] == "keys"
            when ev["type"] == "eof"
                set going to false
            otherwise when ev["type"] == "resize"
                ws_send(ws, json_encode({"t": "r", "cols": ev["cols"], "rows": ev["rows"]}))
            -- Ctrl+] lets go; terminals send it as the code of Ctrl+5, and it may come back as either, or as
            -- Ctrl+} (Windows reads the code back through the keyboard layout: } and ] share a key in Spanish)
            otherwise when ev["type"] == "key" and get(ev, "key", "") == "char" and ev["ctrl"] and ev["text"] in ["]", "5", "}"]
                set going to false
            otherwise
                let k be typed(ev)
                when k != ""
                    ws_send(ws, json_encode({"t": "i", "d": k}))
    ws_close(ws)
    give why

task attach(ref)
    let term be term_open({"ctrl_c": "key"})
    when term == nothing
        fail("atr attach needs a terminal; from a script, use the window (atr open " + ref + ")")
    let why be attach_in(term, ref)
    term_write(term, RESET + "\r\n")
    term_close(term)
    when why == "soltaste"
        say("atril: soltaste " + ref + " y sigue corriendo. Volvé con: atr attach " + ref + "  (o en la app)")
    otherwise
        say("atril: " + ref + " " + why)

-- ---- atr top: the sessions of this machine in this terminal, live, grouped by folder; the arrows
-- choose one, Enter goes into it and Ctrl+] comes back to the list. For SSH, where there is no window

-- the daemon's answer, or nothing: here an error must not leave the terminal in the list's screen
task fetch(c, path)
    try
        let r be http_get(BASE + path, headers(c), nothing, 3)
        give when ok of r then json of r otherwise nothing
    recover e
        give nothing

-- in the window's words (ui/app.js label), with a color
task state_of(s)
    when s["status"] == "exited"
        give ["terminó " + text(s["exit_code"]), "2"]
    when s["bell"]
        give ["te necesita", "33;1"]
    when s["activity"] == "working"
        give ["trabajando", "36"]
    give [(when s["kind"] == "shell" then "inactiva" otherwise "esperándote"), "32"]

task last_part(p)
    give regex_replace(regex_replace(replace(text(p), "\\", "/"), "/+$", ""), "^.*/", "")

task space_of(s)
    give text(get(s, "space", s["cwd"]))

-- the sessions of one folder together, the folders in the order they appeared
task by_space(items)
    let spaces be []
    each s in items
        when not (space_of(s) in spaces)
            set spaces to spaces + [space_of(s)]
    let res be []
    each k in spaces
        set res to res + where(items, (s) => space_of(s) == k)
    give res

-- one line of [text, color] parts cut to the width; the chosen one in reverse video
task segs(parts, w, chosen)
    let out be ""
    let left be w
    each g in parts
        let t be text(g[0])
        when length(t) > left
            set t to slice(t, 0, left)
        set left to left - length(t)
        when t != ""
            set out to out + (when chosen or g[1] == "" then t otherwise ESC + "[" + g[1] + "m" + t + ESC + "[0m")
    when chosen
        give ESC + "[7m" + out + pad("", left) + ESC + "[0m"
    give out + ESC + "[K"

task top_screen(items, out, sel, size, machine, note)
    let w be size["cols"] - 1
    let body be []
    let at be 0
    let space be nothing
    let i be 0
    each s in items
        when space_of(s) != space
            set space to space_of(s)
            when length(body) > 0
                set body to body + [ESC + "[K"]
            set body to body + [segs([["  " + last_part(s["cwd"]), "1"], ["  " + text(s["cwd"]), "2"]], w, false)]
        let st be state_of(s)
        -- the title the program gave itself; a shell's is often only the path of its .exe
        let t be text(get(s, "title", ""))
        let title be when t != "" and t != s["name"] and regex_capture(t, "^[A-Za-z]:\\\\|^/|\\.[Ee][Xx][Ee]$") == nothing then "  " + t otherwise ""
        when i == sel
            set at to length(body)
        set body to body + [segs([[(when i == sel then "  ▸ " otherwise "    "), ""], [pad(s["id"], 5), "2"],
            [pad(regex_replace(last_part(s["cmd"]), "\\.[Ee][Xx][Ee]$", ""), 11), ""], [pad(st[0], 14), st[1]],
            [pad(ago(s["started"]), 5), "2"], [s["name"], ""], [title, "2"]], w, i == sel)]
        set i to i + 1
    when length(items) == 0
        set body to [segs([["  No hay sesiones. ", ""], ["n", "1"], [" abre tu shell en " + cwd() + "; atr claude (o codex, opencode…) un agente.", ""]], w, false)]
    when length(out) > 0
        set body to body + [ESC + "[K", segs([["  fuera de Atril: se ven, pero su pantalla está en otra terminal (arrancalos con atr <agente>)", "2"]], w, false)]
        each o in out
            set body to body + [segs([["    " + pad(o["kind"], 11) + "pid " + pad(o["pid"], 8) + (when o["cwd"] == nothing then "" otherwise o["cwd"]), "2"]], w, false)]
    -- the body scrolls to keep the chosen session on screen
    let room be size["rows"] - 4
    when room < 1
        set room to 1
    let from be when at >= room then at - room + 1 otherwise 0
    let lines be [segs([[" atril", "1"], [" · " + machine + " · " + text(length(items)) + (when length(items) == 1 then " sesión" otherwise " sesiones"), "2"]], w, false), ESC + "[K"]
    let n be 0
    while n < room
        set lines to lines + [when from + n < length(body) then body[from + n] otherwise ESC + "[K"]
        set n to n + 1
    set lines to lines + [segs([["  " + note, "33"]], w, false)]
    set lines to lines + [segs([[" ↑↓", "1"], [" elegir  ", "2"], ["Enter", "1"], [" entrar (Ctrl+] vuelve acá)  ", "2"], ["n", "1"], [" shell nueva  ", "2"], ["x", "1"], [" terminar  ", "2"], ["q", "1"], [" salir", "2"]], w, false)]
    give ESC + "[H" + join(lines, "\r\n") + ESC + "[J"

-- into a session from the list, and back; gives what to say under the list
task went_in(term, c, s)
    let why be "soltaste"
    try
        set why to attach_in(term, s["id"])
    recover e
        set why to text(e)
    term_write(term, RESET + ESC + "[?1049h" + ESC + "[?25l" + ESC + "[2J")
    give when why == "soltaste" then "soltaste " + s["name"] + ": sigue corriendo" otherwise s["name"] + ": " + why

-- false when this is not a terminal
task top()
    let c be up()
    let term be term_open({"ctrl_c": "key"})
    when term == nothing
        give false
    term_write(term, ESC + "[?1049h" + ESC + "[?25l")
    let size be term_size(term)
    let items be []
    let out be []
    let sel be 0
    let note be ""
    let armed be nothing   -- the session a second x ends
    let seen be ""
    let next be 0
    let dirty be true
    let going be true
    while going
        when now() >= next
            let got be fetch(c, "/api/sessions")
            when got != nothing
                set items to by_space(got["items"])
            let o be fetch(c, "/api/outside")
            set out to when o == nothing then [] otherwise o["items"]
            when got == nothing
                set note to "Atril no contesta en " + BASE
            set next to now() + 1
            let now_seen be json_encode(items) + json_encode(out) + note
            when now_seen != seen
                set seen to now_seen
                set dirty to true
        when sel > length(items) - 1
            set sel to when length(items) > 0 then length(items) - 1 otherwise 0
        when dirty
            term_write(term, top_screen(items, out, sel, size, c["machine"], note))
            set dirty to false
        let ev be select({"keys": term}, 1)
        when ev != nothing
            set dirty to true
            let k be get(ev, "key", "")
            let ch be when k == "char" and not ev["ctrl"] then ev["text"] otherwise ""
            let chosen be when length(items) > 0 then items[sel] otherwise nothing
            when ev["type"] == "resize"
                set size to {"cols": ev["cols"], "rows": ev["rows"]}
            otherwise when ev["type"] == "eof"
                set going to false
            -- only the keys the list uses: a terminal may send more than one event for a key (on
            -- Windows, Ctrl+] comes back as Ctrl+] and Ctrl+}), and the rest must not wipe the note
            otherwise when ev["type"] == "key" and (ch in ["q", "k", "j", "n", "x"] or k in ["escape", "up", "down", "home", "end", "enter"] or (k == "char" and ev["ctrl"] and lower(ev["text"]) in ["c", "d"]))
                when ch != "x"
                    set armed to nothing
                set note to ""
                when k == "escape" or ch == "q" or (k == "char" and ev["ctrl"] and lower(ev["text"]) in ["c", "d"])
                    set going to false
                otherwise when k == "up" or ch == "k"
                    set sel to when sel > 0 then sel - 1 otherwise sel
                otherwise when k == "down" or ch == "j"
                    set sel to when sel < length(items) - 1 then sel + 1 otherwise sel
                otherwise when k == "home"
                    set sel to 0
                otherwise when k == "end"
                    set sel to when length(items) > 0 then length(items) - 1 otherwise 0
                otherwise when k == "enter" and chosen != nothing
                    when chosen["status"] == "exited"
                        set note to chosen["name"] + " ya terminó: x la saca de la lista"
                    otherwise
                        set note to went_in(term, c, chosen)
                        set next to 0
                otherwise when ch == "n"
                    try
                        let r be http_post(BASE + "/api/sessions", {"cwd": cwd()}, headers(c))
                        when ok of r
                            set note to went_in(term, c, json of r)
                        otherwise
                            set note to "no se pudo abrir: " + body of r
                    recover e
                        set note to "no se pudo abrir: " + text(e)
                    set next to 0
                otherwise when ch == "x" and chosen != nothing
                    let gone be chosen["status"] == "exited"
                    when armed != chosen["id"]
                        set armed to chosen["id"]
                        set note to "x otra vez " + (when gone then "saca " + chosen["name"] + " de la lista" otherwise "termina " + chosen["name"] + " (" + last_part(chosen["cmd"]) + ")")
                    otherwise
                        set armed to nothing
                        try
                            when gone
                                http_delete(BASE + "/api/sessions/" + chosen["id"], headers(c))
                            otherwise
                                http_post(BASE + "/api/sessions/" + chosen["id"] + "/kill", {}, headers(c))
                            set note to chosen["name"] + (when gone then " salió de la lista" otherwise " terminada")
                        recover e
                            set note to text(e)
                        set next to 0
    term_write(term, RESET + ESC + "[?1049l")
    term_close(term)
    give true

-- the agents `atr <name>` starts here and shows in this terminal
let AGENT_CMDS be ["claude", "codex", "opencode", "gemini", "lampson", "aider", "goose", "qwen", "crush", "droid", "copilot"]

-- `atr run`: flags first, then the command and its arguments untouched
task new_session(rest)
    let body be {"cwd": cwd()}
    let i be 0
    let open be false
    let here be false
    while i < length(rest) and starts_with(rest[i], "--")
        let f be rest[i]
        when f == "--"
            set i to i + 1
            stop
        when f == "--open"
            set open to true
            set i to i + 1
        otherwise when f == "--attach" or f == "-a"
            set here to true
            set i to i + 1
        otherwise when (f == "--name" or f == "--cwd") and i + 1 < length(rest)
            set body[slice(f, 2)] to rest[i + 1]
            set i to i + 2
        otherwise
            fail("unknown flag " + f)
    when i < length(rest)
        set body["cmd"] to rest[i]
        set body["args"] to slice(rest, i + 1)
    let s be api("POST", "/api/sessions", body)
    when here
        attach(s["id"])
        give nothing
    say(s["id"] + "  " + s["name"] + "  pid " + text(s["pid"]))
    when open
        open_window(s["id"], false)

-- "hace 3 min" from a unix time
task ago(t)
    when t == nothing
        give "nunca"
    let d be floor(now() - t)
    when d < 60
        give "recién"
    when d < 3600
        give "hace " + text(d // 60) + " min"
    when d < 86400
        give "hace " + text(d // 3600) + " h"
    give "hace " + text(d // 86400) + " días"

task pair()
    let before be apply(api("GET", "/api/remote/devices", nothing)["devices"], (d) => d["id"])
    let p be api("POST", "/api/remote/pair", {})
    say("Escaneá este código con la cámara del teléfono (vale " + text(p["expires_in"] // 60) + " minutos, un solo uso):")
    say("")
    say(qr.terminal(qr.encode(p["url"])))
    say("")
    say("o abrí en el teléfono: " + p["url"])
    say("")
    say("Esperando al teléfono… (Ctrl+C para salir; el código sigue valiendo hasta que venza)")
    let until be now() + p["expires_in"]
    while now() < until
        sleep(2)
        each d in api("GET", "/api/remote/devices", nothing)["devices"]
            when not (d["id"] in before)
                say("✓ emparejado: " + d["name"] + " (" + d["id"] + "). Lo quitás con `atr devices rm " + d["id"] + "`.")
                give nothing
    say("El código venció sin que se use. `atr pair` da otro.")

task devices(rest)
    when length(rest) >= 2 and rest[0] == "rm"
        api("POST", "/api/remote/devices/" + rest[1] + "/remove", {})
        say("quitado " + rest[1] + ": ya no puede entrar, y si estaba conectado se cortó")
        give nothing
    let r be api("GET", "/api/remote/devices", nothing)
    when length(r["devices"]) == 0
        say("ningún teléfono emparejado. `atr pair` empareja uno.")
        give nothing
    each d in r["devices"]
        say(d["id"] + "  " + d["name"] + "  emparejado " + ago(d["created"]) + ", último uso " + ago(d["last"]))
    let l be r["link"]
    say("")
    say("relay: " + (when l == nothing then "sin conexión" otherwise l["status"] + (when l["error"] != nothing then " (" + l["error"] + ")" otherwise "")))

task relay_show(r)
    when r["relay"] == nothing
        say("sin relay: elegí dónde corre en la ventana (Agregar dispositivo → Teléfono)")
        give nothing
    let pr be r["probe"]
    let who be when r["relay"] == r["default"] then " (el de Synsema)" otherwise " (tuyo)"
    say("relay: " + r["relay"] + who)
    say(when not pr["ok"] then "no responde: " + text(pr["error"]) otherwise when pr["ms"] != nothing then "un mensaje va y vuelve en " + text(pr["ms"]) + " ms desde esta computadora" otherwise "responde")
    when r["env"]
        say("(lo fija ATRIL_RELAY en el entorno del daemon)")

task relay(rest)
    when length(rest) >= 2 and rest[0] == "use"
        let addr be when rest[1] == "synsema" then "wss://relay.atril.dev" otherwise rest[1]
        relay_show(api("POST", "/api/remote/relay", {"relay": addr}))
        say("los teléfonos conectados ahora se pasan solos; uno que no estaba conectado tiene que escanear un código nuevo")
        give nothing
    when length(rest) > 0
        fail("atr relay [use <dirección>|use synsema]")
    relay_show(api("GET", "/api/remote/relay", nothing))

let a be args()
let cmd be when length(a) == 0 then "open" otherwise a[0]
let rest be when length(a) > 1 then slice(a, 1) otherwise []

when cmd == "open"
    let refs be where(rest, (x) => not starts_with(x, "--"))
    open_window(when length(refs) > 0 then refs[0] otherwise nothing, contains(rest, "--new"))
otherwise when cmd == "run" or cmd == "new"
    new_session(rest)
otherwise when cmd == "ls" or cmd == "list"
    list(contains(rest, "--json"))
otherwise when cmd == "name" or cmd == "rename"
    when length(rest) < 2
        fail("atr name <session> <title>")
    let r be api("POST", "/api/sessions/" + rest[0] + "/rename", {"name": join(slice(rest, 1), " ")})
    say(r["id"] + " is now \"" + r["name"] + "\"")
otherwise when cmd == "kill"
    when length(rest) == 0
        fail("atr kill <session>")
    api("POST", "/api/sessions/" + rest[0] + "/kill", {})
    say("killed " + rest[0])
otherwise when cmd == "rm"
    when length(rest) == 0
        fail("atr rm <session>")
    api("DELETE", "/api/sessions/" + rest[0], nothing)
    say("removed " + rest[0])
otherwise when cmd == "attach" or cmd == "a"
    -- without a session: the only one running, or the list to choose
    when length(rest) == 0
        let live be where(api("GET", "/api/sessions", nothing)["items"], (s) => s["status"] != "exited")
        when length(live) == 0
            fail("no hay sesiones vivas. `atr run` abre tu shell; `atr claude` (o codex, opencode…) un agente")
        when length(live) == 1
            attach(live[0]["id"])
        otherwise when not top()
            fail("atr attach <session>   (atr ls lists them)")
    otherwise
        attach(rest[0])
otherwise when cmd == "top"
    when not top()
        fail("atr top needs a terminal; `atr ls` prints the list")
otherwise when cmd in AGENT_CMDS
    new_session(["--attach", cmd] + rest)
otherwise when cmd == "url"
    say(url_of(when length(rest) > 0 then rest[0] otherwise nothing))
otherwise when cmd == "version" or cmd == "--version"
    say("atril " + VERSION)
otherwise when cmd == "up"
    let c be up()
    say("atril is running on " + BASE + " (" + c["machine"] + ")")
otherwise when cmd == "pair"
    pair()
otherwise when cmd == "relay"
    relay(rest)
otherwise when cmd == "devices"
    devices(rest)
otherwise when cmd == "down"
    when alive()
        try
            api("POST", "/api/shutdown", {})
        recover e
            set e to e
    say("atril stopped")
otherwise
    say("atr open [session] | top | claude|codex|… [args] | attach [s] | run [--name N] [--cwd D] [--open] [--attach] [cmd args…] | ls [--json] | name <s> <title> | kill <s> | rm <s> | url [session] | pair | devices [rm <id>] | relay [use <address>] | up | down")
