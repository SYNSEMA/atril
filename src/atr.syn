-- atr.syn — the Atril command line. It talks to the daemon of this machine and starts it when it is
-- not running. Installed, it is atr.exe next to atrild.exe. From the source, the launchers
-- cli/atr.cmd and cli/atr set ATRIL_HOME and the daemon runs as `synsema serve src/atrild.syn`.
--
--   atr open [session] [--new]     the window (starts the daemon if needed); with a session, on that tab.
--                                  A window already open shows it instead, unless --new
--   atr run [--name N] [--cwd D] [--open] [--attach] [cmd args…]
--                                  a new session (your shell without cmd), in this folder unless --cwd;
--                                  it outlives every window. --attach shows it in this terminal
--   atr claude | codex | … [args]  that agent in a new session here, shown in this terminal (over SSH
--                                  too): Ctrl+] lets go of it and it keeps running; the app sees it
--   atr attach <session>           a session in this terminal; Ctrl+] lets go of it
--   atr ls [--json]                the sessions of this machine
--   atr name <session> <title…>    give a session a title: what you do there, to find it later
--   atr kill <session>             end the program of a session (id, name or pid)
--   atr rm <session>               forget a session that already ended
--   atr url [session]              the address of the window with its key (for a browser elsewhere,
--                                  through `ssh -L 7172:127.0.0.1:7171 <server>`: change the port)
--   atr up | atr down              start the daemon | stop it (and every session with it)

require net("127.0.0.1:7171")
require file.read("~/.atril/*")
require env("ATRIL_HOME")
require env("USERPROFILE")
require env("HOME")
require env("DISPLAY")
require env("WAYLAND_DISPLAY")
require stdout
require time
require exec("powershell")
require exec("sh")
require exec("open")
require exec("xdg-open")
require stdin
require file.read(".")      -- the folder you are in: where `atr run` and `atr claude` start

use "./window.syn" as window

let BASE be "http://127.0.0.1:7171"
let WIN be platform()["os"] == "windows"
let VERSION be "0.2.0"

task say(t)
    print(t)

task fail(t)
    print("atr: " + t)
    exit(1)

task conf()
    try
        give json_decode(read_file("~/.atril/daemon.json"))
    recover e
        give nothing

task headers(c)
    give {"Authorization": "Bearer " + c["token"]}

-- the daemon answers with this machine's key
task alive()
    let c be conf()
    when c == nothing
        give false
    try
        let r be http_get(BASE + "/api/info", headers(c), nothing, 2)
        give ok of r
    recover e
        give false

task up()
    when alive()
        give conf()
    let home be env("ATRIL_HOME", "")
    let exe be self_path()
    -- from the source: the engine serves src/atrild.syn; installed: atrild next to this binary.
    -- --background: started from here, the daemon opens no window of its own
    let dir be home + "/src"
    let cmd be exe
    let cmd_args be ["serve", "atrild.syn", "--", "--background"]
    when home == ""
        set dir to regex_replace(replace(exe, "\\", "/"), "/[^/]*$", "")
        set cmd to dir + (when WIN then "/atrild.exe" otherwise "/atrild")
        set cmd_args to ["--background"]
    when WIN
        -- no -Redirect*: with it the daemon inherits this pipe and `run` would wait for it forever
        let q be (t) => "'" + replace(t, "'", "''") + "'"
        let al be when length(cmd_args) == 0 then "" otherwise " -ArgumentList " + join(apply(cmd_args, q), ",")
        run("powershell", ["-NoProfile", "-Command", "Start-Process -WindowStyle Hidden -FilePath " + q(cmd) + al + " -WorkingDirectory " + q(dir)])
    otherwise
        run("sh", ["-c", "mkdir -p \"$HOME/.atril\" && cd \"$1\" && shift && nohup \"$@\" >\"$HOME/.atril/daemon.log\" 2>&1 &", "sh", dir, cmd] + cmd_args)
    let tries be 0
    while not alive() and tries < 40
        sleep(0.25)
        set tries to tries + 1
    when not alive()
        fail("the daemon did not start; look at ~/.atril/daemon.log")
    give conf()

task api(method, path, body)
    let c be up()
    let r be nothing
    when method == "GET"
        set r to http_get(BASE + path, headers(c))
    otherwise when method == "POST"
        set r to http_post(BASE + path, body, headers(c))
    otherwise
        set r to http_delete(BASE + path, headers(c))
    when not (ok of r)
        let j be json of r
        fail(when j != nothing then text(get(j, "error", body of r)) otherwise body of r)
    give json of r

task url_of(ref)
    let c be up()
    give BASE + "/#t=" + c["token"] + (when ref == nothing then "" otherwise "&s=" + ref)

-- a window is already open: it shows the session itself, and no second window appears
task show_in_open_window(ref)
    try
        let r be api("POST", "/api/show", {"ref": ref})
        give r["shown"]
    recover e
        give false

task open_window(ref, fresh)
    when not fresh and show_in_open_window(ref)
        say("Atril ya estaba abierto: " + (when ref == nothing then "está en esa ventana" otherwise "abrí " + ref + " ahí") + ". (atr open --new abre otra ventana)")
        give nothing
    let url be url_of(ref)
    when not WIN and platform()["os"] != "macos" and env("DISPLAY", "") == "" and env("WAYLAND_DISPLAY", "") == ""
        say("no screen here. From your computer:")
        say("  ssh -L 7172:127.0.0.1:7171 <this server>")
        say("  then open " + replace(url, ":7171/", ":7172/"))
        give nothing
    window.open_url(url)

task ago(ts)
    let d be now() - ts
    when d < 60
        give text(floor(d)) + "s"
    when d < 3600
        give text(floor(d / 60)) + "m"
    when d < 86400
        give text(floor(d / 3600)) + "h"
    give text(floor(d / 86400)) + "d"

task pad(t, n)
    let s be text(t)
    while length(s) < n
        set s to s + " "
    give s

task list(as_json)
    let items be api("GET", "/api/sessions", nothing)["items"]
    when as_json
        say(json_encode(items))
        give nothing
    when length(items) == 0
        say("no sessions. `atr run` opens one.")
    otherwise
        say(pad("ID", 6) + pad("NAME", 20) + pad("PID", 8) + pad("STATE", 12) + pad("AGE", 6) + "COMMAND")
    each s in items
        let st be s["activity"]
        when s["status"] == "exited"
            set st to "exited " + text(s["exit_code"])
        otherwise when s["bell"]
            set st to "needs you"
        say(pad(s["id"], 6) + pad(s["name"], 20) + pad(s["pid"], 8) + pad(st, 12) + pad(ago(s["started"]), 6) + s["cmd"] + " " + join(s["args"], " "))
    -- agents running here outside Atril: seen, not attachable
    let out be api("GET", "/api/outside", nothing)["items"]
    when length(out) > 0
        say("")
        say("outside Atril (their screen is in another terminal; start them with `atr <agent>` to have them here):")
        each o in out
            say("  " + pad(o["kind"], 12) + "pid " + pad(o["pid"], 8) + (when o["cwd"] == nothing then "" otherwise o["cwd"]))

-- ---- a session in this terminal: keys go to it, its screen comes here, Ctrl+] lets go

let ESC be decode(bytes([27]), "utf8")
let KEYS be {"enter": "\r", "tab": "\t", "backtab": ESC + "[Z", "backspace": decode(bytes([127]), "utf8"),
    "delete": ESC + "[3~", "insert": ESC + "[2~", "escape": ESC, "up": ESC + "[A", "down": ESC + "[B",
    "right": ESC + "[C", "left": ESC + "[D", "home": ESC + "[H", "end": ESC + "[F", "pageup": ESC + "[5~",
    "pagedown": ESC + "[6~", "f1": ESC + "OP", "f2": ESC + "OQ", "f3": ESC + "OR", "f4": ESC + "OS",
    "f5": ESC + "[15~", "f6": ESC + "[17~", "f7": ESC + "[18~", "f8": ESC + "[19~", "f9": ESC + "[20~",
    "f10": ESC + "[21~", "f11": ESC + "[23~", "f12": ESC + "[24~"}

-- what a key event types into a terminal
task typed(ev)
    when ev["type"] == "paste"
        give ev["text"]
    let out be get(KEYS, ev["key"], "")
    when ev["key"] == "char"
        set out to ev["text"]
        when ev["ctrl"] and length(out) == 1
            let i be index_of("abcdefghijklmnopqrstuvwxyz", lower(out))
            when i != nothing
                set out to decode(bytes([i + 1]), "utf8")
            otherwise when out in ["@", " ", "2"]
                set out to decode(bytes([0]), "utf8")
            -- a terminal sends Ctrl+3..7 with the codes of Ctrl+[ \ ] ^ _ (27..31): read back as digits
            otherwise when out in ["3", "4", "5", "6", "7"]
                set out to decode(bytes([index_of("34567", out) + 27]), "utf8")
            otherwise when out in ["[", "\\", "^", "_"]
                set out to decode(bytes([index_of("[\\]^_", out) + 27]), "utf8")
    when ev["alt"] and out != ""
        set out to ESC + out
    give out

task attach(ref)
    let c be up()
    let term be term_open({"ctrl_c": "key"})
    when term == nothing
        fail("atr attach needs a terminal; from a script, use the window (atr open " + ref + ")")
    let ws be ws_connect("ws://127.0.0.1:7171/api/sessions/" + ref + "/attach", headers(c))
    let size be term_size(term)
    ws_send(ws, json_encode({"t": "r", "cols": size["cols"], "rows": size["rows"]}))
    term_write(term, ESC + "[2J" + ESC + "[H")
    let why be "soltaste"
    let going be true
    while going
        let ev be select({"keys": term, "ws": ws}, 30)
        when ev != nothing and ev["name"] == "ws"
            when ev["type"] == "close"
                set why to "se cortó la conexión con Atril"
                set going to false
            otherwise when ev["type"] == "text"
                let m be json_decode(ev["data"], nothing)
                when m != nothing and m["t"] == "o"
                    term_write(term, m["d"])
                otherwise when m != nothing and m["t"] == "exit"
                    set why to "terminó (código " + text(m["code"]) + ")"
                    set going to false
                otherwise when m != nothing and m["t"] == "error"
                    set why to m["error"]
                    set going to false
        otherwise when ev != nothing and ev["name"] == "keys"
            when ev["type"] == "eof"
                set going to false
            otherwise when ev["type"] == "resize"
                ws_send(ws, json_encode({"t": "r", "cols": ev["cols"], "rows": ev["rows"]}))
            -- Ctrl+] lets go; terminals send it as the code of Ctrl+5, and it may come back as either
            otherwise when ev["type"] == "key" and ev["key"] == "char" and ev["ctrl"] and ev["text"] in ["]", "5"]
                set going to false
            otherwise
                let k be typed(ev)
                when k != ""
                    ws_send(ws, json_encode({"t": "i", "d": k}))
    ws_close(ws)
    term_write(term, ESC + "[0m\r\n")
    term_close(term)
    when why == "soltaste"
        say("atril: soltaste " + ref + " y sigue corriendo. Volvé con: atr attach " + ref + "  (o en la app)")
    otherwise
        say("atril: " + ref + " " + why)

-- the agents `atr <name>` starts here and shows in this terminal
let AGENT_CMDS be ["claude", "codex", "opencode", "gemini", "lampson", "aider", "goose", "qwen", "crush", "droid", "copilot"]

-- `atr run`: flags first, then the command and its arguments untouched
task new_session(rest)
    let body be {"cwd": cwd()}
    let i be 0
    let open be false
    let here be false
    while i < length(rest) and starts_with(rest[i], "--")
        let f be rest[i]
        when f == "--"
            set i to i + 1
            stop
        when f == "--open"
            set open to true
            set i to i + 1
        otherwise when f == "--attach" or f == "-a"
            set here to true
            set i to i + 1
        otherwise when (f == "--name" or f == "--cwd") and i + 1 < length(rest)
            set body[slice(f, 2)] to rest[i + 1]
            set i to i + 2
        otherwise
            fail("unknown flag " + f)
    when i < length(rest)
        set body["cmd"] to rest[i]
        set body["args"] to slice(rest, i + 1)
    let s be api("POST", "/api/sessions", body)
    when here
        attach(s["id"])
        give nothing
    say(s["id"] + "  " + s["name"] + "  pid " + text(s["pid"]))
    when open
        open_window(s["id"], false)

let a be args()
let cmd be when length(a) == 0 then "open" otherwise a[0]
let rest be when length(a) > 1 then slice(a, 1) otherwise []

when cmd == "open"
    let refs be where(rest, (x) => not starts_with(x, "--"))
    open_window(when length(refs) > 0 then refs[0] otherwise nothing, contains(rest, "--new"))
otherwise when cmd == "run" or cmd == "new"
    new_session(rest)
otherwise when cmd == "ls" or cmd == "list"
    list(contains(rest, "--json"))
otherwise when cmd == "name" or cmd == "rename"
    when length(rest) < 2
        fail("atr name <session> <title>")
    let r be api("POST", "/api/sessions/" + rest[0] + "/rename", {"name": join(slice(rest, 1), " ")})
    say(r["id"] + " is now \"" + r["name"] + "\"")
otherwise when cmd == "kill"
    when length(rest) == 0
        fail("atr kill <session>")
    api("POST", "/api/sessions/" + rest[0] + "/kill", {})
    say("killed " + rest[0])
otherwise when cmd == "rm"
    when length(rest) == 0
        fail("atr rm <session>")
    api("DELETE", "/api/sessions/" + rest[0], nothing)
    say("removed " + rest[0])
otherwise when cmd == "attach" or cmd == "a"
    when length(rest) == 0
        fail("atr attach <session>   (atr ls lists them)")
    attach(rest[0])
otherwise when cmd in AGENT_CMDS
    new_session(["--attach", cmd] + rest)
otherwise when cmd == "url"
    say(url_of(when length(rest) > 0 then rest[0] otherwise nothing))
otherwise when cmd == "version" or cmd == "--version"
    say("atril " + VERSION)
otherwise when cmd == "up"
    let c be up()
    say("atril is running on " + BASE + " (" + c["machine"] + ")")
otherwise when cmd == "down"
    when alive()
        try
            api("POST", "/api/shutdown", {})
        recover e
            set e to e
    say("atril stopped")
otherwise
    say("atr open [session] | claude|codex|… [args] | attach <s> | run [--name N] [--cwd D] [--open] [--attach] [cmd args…] | ls [--json] | name <s> <title> | kill <s> | rm <s> | url [session] | up | down")
