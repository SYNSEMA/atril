-- atrild.syn — the Atril daemon: owns the terminals of this machine. It is also what the Start menu
-- opens: started with no argument it opens the window too; when another daemon already answers, it
-- only shows that one's window and ends before listening. `atrild --background` never opens a window
-- (sign-in, `atr up`).
--
-- Every session is a Synsema agent that owns one pseudo-terminal. A window that attaches only
-- subscribes to the session's output on the bus and publishes keys to it, so closing the window
-- detaches: the program keeps running until it exits by itself, someone presses Ctrl-C inside it,
-- or someone kills it on purpose (`atr kill`, or the menu of the sidebar).
--
--   bus  in.<id>    what reaches a session: {t: "i", d: keys} | {t: "r", cols, rows} | {t: "snap", to} | {t: "kill"}
--   bus  out.<id>   what a session says:    {t: "o", s: seq, d: text} | {t: "snap", s, d, to} | {t: "exit", code}
--   bus  sessions   the metadata of a session changed (the sidebar listens)
--   state sess:<id> the metadata of each session, for listing
--
-- Security (v0.1, one machine):
--   - it listens on 127.0.0.1 only: from another computer there is no port to find
--   - every route but the static UI needs the token written at start to ~/.atril/daemon.json
--     (Authorization: Bearer, or the HttpOnly SameSite=Strict cookie the UI gets at /api/login)
--   - Host must be 127.0.0.1 or localhost (DNS rebinding) on any port, so an SSH tunnel
--     (`ssh -L 7172:127.0.0.1:7171 vps`) works; Origin, when sent, must be exactly that host and
--     port (a web page you visit cannot open a socket to your terminals)

require serve(7171)
require exec
require time
require random
require stdout
require env("COMPUTERNAME")
require env("HOSTNAME")
require env("SHELL")
require env("USERPROFILE")
require env("HOME")
require file.write("~/.atril/*")
require file.read          -- a space's .git/HEAD, wherever the project lives (its shells can read it anyway)
require net("127.0.0.1")     -- this daemon, and the tunnels to the other machines

use "./window.syn" as window

let PORT be 7171
let VERSION be "0.3.4"
let TOKEN be token(32)
let KEEP be 524288          -- characters of scrollback each session keeps for a window that attaches
-- the name of this computer: Windows says it in COMPUTERNAME; on Linux a daemon started over SSH may
-- not have HOSTNAME, so /etc/hostname
task machine_name()
    let n be env("COMPUTERNAME", env("HOSTNAME", ""))
    when n == ""
        try
            set n to trim(read_file("/etc/hostname"))
        recover e
            set n to ""
    give when n == "" then "this computer" otherwise n

let MACHINE be machine_name()
let HOME be env("USERPROFILE", env("HOME", "."))

let BACKGROUND be length(args()) > 0 and args()[0] == "--background"

-- the daemon that already answers on this machine, with its key, or nothing
task running_daemon()
    try
        let c be json_decode(read_file("~/.atril/daemon.json"))
        let r be http_get("http://127.0.0.1:" + text(PORT) + "/api/info", {"Authorization": "Bearer " + c["token"]}, nothing, 2)
        when ok of r
            give c
    recover e
        give nothing
    give nothing

let OTHER be running_daemon()
when OTHER != nothing
    when not BACKGROUND
        let h be {"Authorization": "Bearer " + OTHER["token"]}
        let shown be false
        try
            set shown to (json of http_post("http://127.0.0.1:" + text(PORT) + "/api/show", {}, h, 3))["shown"]
        recover e
            set shown to false
        when not shown
            window.open_url("http://127.0.0.1:" + text(PORT) + "/#t=" + OTHER["token"])
    -- nothing to serve: end here. Under serve, exit() ends the program with an error line, which this
    -- console-less binary never shows
    exit(0)

write_file("~/.atril/daemon.json", json_encode({"port": PORT, "token": TOKEN, "machine": MACHINE}))

-- the shell a new tab opens when nothing else is asked for
task default_shell()
    when platform()["os"] == "windows"
        give {"cmd": "powershell", "args": ["-NoLogo"]}
    give {"cmd": env("SHELL", "bash"), "args": ["-l"]}

-- the agents Atril knows by their command; add yours to ~/.atril/agents.json (["myagent", …])
task extra_agents()
    try
        let extra be json_decode(read_file("~/.atril/agents.json"))
        give where(extra, (x) => type_of(x) == "text" and x != "")
    recover e
        give []

let AGENTS be ["claude", "codex", "opencode", "gemini", "aider", "goose", "amp", "cursor-agent", "ollama", "lampson", "qwen", "crush", "droid", "kiro-cli", "copilot"] + apply(extra_agents(), (x) => lower(x))

-- what runs in it, from the program's name: the sidebar groups and marks agents by it
task kind_of(cmd)
    let file be lower(regex_replace(cmd, "^.*[\\\\/]", ""))
    let base be regex_replace(file, "\\.(exe|cmd|bat|ps1)$", "")
    when base in AGENTS
        give base
    give "shell"

-- an agent started inside a shell names itself in the title ("✳ Claude Code"): then the session is that agent
task kind_from_title(title)
    let t be lower(text(title))
    each pair in [["claude code", "claude"], ["codex", "codex"], ["opencode", "opencode"], ["gemini", "gemini"], ["aider", "aider"], ["goose", "goose"], ["lampson", "lampson"]]
        when contains(t, pair[0])
            give pair[1]
    -- OpenCode names its window after the conversation: "OC | Saludo rápido"
    when starts_with(t, "oc | ")
        give "opencode"
    give nothing

-- the agent a typed command starts: "codex", "npx @openai/codex", "claude --resume" → its kind, or nothing
task agent_of(command)
    let words be where(split(trim(text(command)), " "), (w) => w != "")
    when length(words) == 0
        give nothing
    let w be words[0]
    when lower(w) in ["npx", "bunx", "pnpx", "pnpm", "yarn"] and length(words) > 1
        set w to regex_replace(words[1], "^@[^/]+/", "")
    let k be kind_of(w)
    give when k == "shell" then nothing otherwise k

-- what an agent prints when it starts, for one launched some other way (a script, an alias)
task agent_in_banner(text_after)
    each pair in [["OpenAI Codex", "codex"], ["Claude Code", "claude"], ["Gemini CLI", "gemini"], ["opencode", "opencode"], ["Aider v", "aider"], ["harness de agente en Synsema", "lampson"]]
        when contains(text_after, pair[0])
            give pair[1]
    give nothing

-- what PowerShell's own screen says (its prompt is "PS C:\folder> "): the folder of the last prompt,
-- whether the shell sits at that prompt (nothing runs), and what was typed after it. nothing when no
-- prompt is in view (another shell, or a full-screen program cleared it)
task read_screen(screen)
    let prompts be regex_find_all(screen, "PS [A-Za-z]:[^>\r\n]*>[^\r\n]*")
    when length(prompts) == 0
        give nothing
    let last be prompts[length(prompts) - 1]
    let cap be regex_capture(last, "^PS ([A-Za-z]:[^>\r\n]*)> *(.*)$")
    when cap == nothing
        give nothing
    -- what follows the last time that line appears
    let pieces be split(screen, last)
    let after be pieces[length(pieces) - 1]
    give {"folder": cap[0], "typed": trim(cap[1]), "at_prompt": trim(after) == "", "after": after}

-- the folder as Windows spells it on disk ("desktop" → "Desktop"): tools that key by path, like
-- Claude Code's trusted folders, then see one folder and not two
task real_case(path)
    when platform()["os"] != "windows" or path == nothing
        give path
    let parts be where(split(replace(text(path), "/", "\\"), "\\"), (x) => x != "")
    when length(parts) == 0 or not regex_find_all(parts[0], "^[A-Za-z]:$")
        give path
    let cur be upper(parts[0]) + "\\"
    each part in slice(parts, 1)
        let name be part
        try
            each e in list_dir(cur)
                when lower(e["name"]) == lower(part)
                    set name to e["name"]
        recover err
            set name to part
        set cur to cur + name + "\\"
    give when length(parts) == 1 then cur otherwise slice(cur, 0, length(cur) - 1)

-- the last terminal title in a chunk of output (OSC 0 or 2), or nothing
task title_in(chunk)
    let found be regex_find_all(chunk, "\u001b\\][02];[^\u0007\u001b]*(\u0007|\u001b\\\\)")
    when length(found) == 0
        give nothing
    let last be found[length(found) - 1]
    give regex_replace(regex_replace(last, "^\u001b\\][02];", ""), "(\u0007|\u001b\\\\)$", "")

-- ---- spaces: the folders sessions run in, each with its git branch

-- one spelling per folder: / separators, no trailing /, case-blind on Windows
task space_key(path)
    let p be regex_replace(replace(text(path), "\\", "/"), "/+$", "")
    give when platform()["os"] == "windows" then lower(p) otherwise p

-- the folder of the repository that holds dir (looking up its parents), or nothing
task git_root(dir)
    let d be regex_replace(replace(text(dir), "\\", "/"), "/+$", "")
    let depth be 0
    while depth < 40
        when file_info(d + "/.git")["exists"]
            give d
        let up be regex_replace(d, "/[^/]*$", "")
        when up == d or up == ""
            give nothing
        set d to up
        set depth to depth + 1
    give nothing

-- the branch of the repository that holds dir (looking up its parents), or nothing
task git_branch(dir)
    let d be regex_replace(replace(text(dir), "\\", "/"), "/+$", "")
    let depth be 0
    while depth < 40
        let g be d + "/.git"
        let info be file_info(g)
        when info["exists"]
            let gitdir be g
            when not info["is_dir"]
                -- a worktree or a submodule: .git is a file saying where the repository is
                set gitdir to trim(replace(read_file(g), "gitdir:", ""))
                when not regex_find_all(gitdir, "^([A-Za-z]:)?/")
                    set gitdir to d + "/" + gitdir
            try
                let head be trim(read_file(gitdir + "/HEAD"))
                when starts_with(head, "ref: refs/heads/")
                    give slice(head, 16)
                give slice(head, 0, 7)
            recover e
                give nothing
        let up be regex_replace(d, "/[^/]*$", "")
        when up == d or up == ""
            give nothing
        set d to up
        set depth to depth + 1
    give nothing

-- the folders inside path, for the picker: hidden and system folders left out, repositories marked
task list_dirs(path)
    let base be regex_replace(replace(text(path), "\\", "/"), "/+$", "")
    when base == ""
        set base to replace(HOME, "\\", "/")
    let dir be when regex_find_all(base, "^[A-Za-z]:$") then base + "/" otherwise base
    let prefix be when ends_with(dir, "/") then dir otherwise dir + "/"
    let out be []
    each e in list_dir(dir)
        when e["is_dir"] and not starts_with(e["name"], ".") and not starts_with(e["name"], "$") and e["name"] != "node_modules" and e["name"] != "System Volume Information" and length(out) < 500
            let child be prefix + e["name"]
            set out to out + [{"name": e["name"], "path": child, "branch": (when file_info(child + "/.git")["exists"] then git_branch(child) otherwise nothing)}]
    let parent be regex_replace(base, "/[^/]*$", "")
    give {"path": dir, "parent": (when parent == base or parent == "" then nothing otherwise parent), "branch": git_branch(dir), "dirs": out}

-- repositories near home, the most recently touched first: what "new" offers before you browse
task suggestions()
    let h be replace(HOME, "\\", "/")
    let seen be []
    let found be []
    each root in [h, h + "/Desktop", h + "/OneDrive/Desktop", h + "/Documents", h + "/Projects", h + "/code", h + "/dev", h + "/src", h + "/source/repos", h + "/repos", h + "/git", h + "/work"]
        when file_info(root)["is_dir"] and space_key(root) not in seen
            set seen to seen + [space_key(root)]
            try
                each e in list_dir(root)
                    let child be root + "/" + e["name"]
                    when e["is_dir"] and not starts_with(e["name"], ".") and file_info(child + "/.git")["exists"] and space_key(child) not in seen
                        set seen to seen + [space_key(child)]
                        let touched be file_info(child + "/.git/index")["modified"]
                        set found to found + [{"name": e["name"], "path": child, "branch": git_branch(child), "touched": (when touched == nothing then 0 otherwise touched)}]
            recover e
                set seen to seen
    give slice(sort_by(found, (r) => r["touched"], desc = true), 0, 40)

-- the spaces live on disk, so they outlast the daemon (a reboot, an update)
task load_spaces()
    try
        let list be json_decode(read_file("~/.atril/spaces.json"))
        give when type_of(list) == "list" then list otherwise []
    recover e
        give []

task save_spaces(list)
    write_file("~/.atril/spaces.json", json_encode(list))

task spaces_view()
    let out be []
    each sp in load_spaces()
        let name be regex_replace(regex_replace(replace(sp["path"], "\\", "/"), "/+$", ""), "^.*/", "")
        set out to out + [{"key": sp["key"], "path": sp["path"], "name": (when name == "" then sp["path"] otherwise name), "branch": git_branch(sp["path"])}]
    give out

task add_space(path)
    let key be space_key(path)
    let all be load_spaces()
    each sp in all
        when sp["key"] == key
            give key
    save_spaces(all + [{"key": key, "path": real_case(path)}])
    bus_publish("spaces", {"changed": key})
    give key

-- ---- the files of a space: the panel on the right (a tree, what git says changed, a file, its diff)
--
-- Read only. A path is always relative to a space you have and never has "..": the panel does not
-- wander off. git runs in a pseudo-terminal (a console-less daemon would otherwise flash a console
-- window on Windows) but what it says goes to a file under ~/.atril/tmp: ConPTY redraws what a program
-- prints (a run of spaces may become a cursor move) and a diff needs every space as it is.

let LIST_MAX be 1000       -- entries of one folder
let FILE_MAX be 200000     -- characters of a file the viewer shows
let GIT_TMP be replace(HOME, "\\", "/") + "/.atril/tmp"

-- the folder of a space you have, by its key, or nothing
task space_root(key)
    let k be space_key(text(key))
    each sp in load_spaces()
        when sp["key"] == k
            give regex_replace(replace(sp["path"], "\\", "/"), "/+$", "")
    give nothing

-- a path inside a space: / separators, "." for the space itself; nothing when it would leave it
task clean_rel(p)
    let r be regex_replace(regex_replace(replace(text(p), "\\", "/"), "^(\\./|/)+", ""), "/+$", "")
    when r == "" or r == "."
        give "."
    when contains(r, ":") or ".." in split(r, "/")
        give nothing
    give r

task abs_in(root, rel)
    let r be when regex_find_all(root, "^[A-Za-z]:$") then root + "/" otherwise root
    give when rel == "." then r otherwise regex_replace(r, "/$", "") + "/" + rel

-- a program run to its end in dir, without a window (see run_quiet); gives its exit code
task run_in(dir, cmd, args, timeout)
    let p be proc_spawn(cmd, args, {"pty": true, "cols": 400, "rows": 20, "cwd": dir})
    let code be nothing
    let deadline be now() + timeout
    while code == nothing and now() < deadline
        let ev be proc_recv(p, 1)
        when ev != nothing and ev["type"] == "exit"
            set code to ev["data"]["exit_code"]
    proc_close(p)
    give when code == nothing then -1 otherwise code

-- what a file under ~/.atril/tmp says, and the file gone; nothing when it cannot be read
task take_tmp(name)
    let out be nothing
    try
        set out to read_file("~/.atril/tmp/" + name)
    recover e
        set out to nothing
    try
        delete_file("~/.atril/tmp/" + name)
    recover e
        set out to out
    give out

-- git status of the space: {repo, branch, changes: {path in the space: M | A | D | R | ??}}. The command
-- line has only fixed words (the folder is the cwd, the output file is under your home): nothing in it
-- comes from a file name
task files_status(root)
    let name be "st-" + token(16) + ".txt"
    write_file("~/.atril/tmp/" + name, "")
    let gargs be ["-c", "core.quotepath=off", "--no-optional-locks", "status", "--porcelain=v1", "-z", "-b", "--untracked-files=all", "--", "."]
    let code be 0
    when platform()["os"] == "windows"
        set code to run_in(root, "cmd", ["/c", "git"] + gargs + [">", GIT_TMP + "/" + name, "2>nul"], 20)
    otherwise
        set code to run_in(root, "sh", ["-c", "out=$1; shift; git \"$@\" > \"$out\" 2>/dev/null", "sh", GIT_TMP + "/" + name] + gargs, 20)
    let out be take_tmp(name)
    when code != 0 or out == nothing
        give {"repo": false, "branch": nothing, "changes": {}}
    -- porcelain paths start at the repository's root; the space may be a folder inside it
    let groot be git_root(root)
    let prefix be ""
    when groot != nothing and length(root) > length(groot)
        set prefix to slice(root, length(groot) + 1) + "/"
    let branch be nothing
    let changes be {}
    let n be 0
    let skip be false
    each item in split(out, "\u0000")
        when skip
            set skip to false
        otherwise when starts_with(item, "## ")
            set branch to split(split(slice(item, 3), "...")[0], " ")[0]
        otherwise when length(item) > 3 and n < 5000
            let xy be slice(item, 0, 2)
            let path be slice(item, 3)
            -- a rename or a copy: the next item is where it came from
            set skip to starts_with(xy, "R") or starts_with(xy, "C")
            let code2 be when xy == "??" then "??" otherwise (when contains(xy, "D") then "D" otherwise (when contains(xy, "A") then "A" otherwise (when contains(xy, "R") then "R" otherwise "M")))
            when prefix == "" or starts_with(lower(path), lower(prefix))
                set changes[slice(path, length(prefix))] to code2
                set n to n + 1
    give {"repo": true, "branch": branch, "changes": changes}

-- one folder of a space: folders first, then files, by name
task list_entries(root, rel)
    let out be []
    each e in list_dir(abs_in(root, rel))
        when e["name"] != ".git" and length(out) < LIST_MAX
            set out to out + [{"name": e["name"], "dir": e["is_dir"], "size": get(e, "size")}]
    give sort_by(where(out, (x) => x["dir"]), (x) => lower(x["name"])) + sort_by(where(out, (x) => not x["dir"]), (x) => lower(x["name"]))

-- a file for the viewer: its text (cut at FILE_MAX), or binary when it is not text
task file_read(root, rel)
    let real be abs_in(root, rel)
    let info be file_info(real)
    when not info["exists"]
        give {"path": rel, "gone": true}
    when info["is_dir"]
        give {"path": rel, "error": "es una carpeta"}
    try
        let content be read_file(real)
        when contains(slice(content, 0, 8000), "\u0000")
            give {"path": rel, "binary": true, "size": info["size"]}
        give {"path": rel, "content": slice(content, 0, FILE_MAX), "truncated": length(content) > FILE_MAX, "size": info["size"], "modified": info["modified"]}
    recover e
        -- read_file only reads UTF-8: an image, a database, an executable
        give {"path": rel, "binary": true, "size": info["size"]}

-- what changed in a file since the last commit (staged or not), as git diff says it; "" when nothing
-- did or git has nothing to compare it with (a new file, a repository without commits)
task file_diff(root, rel)
    let name be "diff-" + token(16) + ".txt"
    write_file("~/.atril/tmp/" + name, "")
    -- no shell here: the file's name reaches git as one argument, and only as a literal path
    let code be run_in(root, "git", ["--literal-pathspecs", "-c", "core.quotepath=off", "--no-pager", "diff", "--no-color", "--no-ext-diff", "HEAD", "--output=" + GIT_TMP + "/" + name, "--", rel], 20)
    let out be take_tmp(name)
    give when code != 0 or out == nothing then "" otherwise slice(out, 0, FILE_MAX * 2)

-- ---- your own themes: every ~/.atril/themes/<name>.json that reads as a map (ui/themes/README.md
-- says the format). The window lists them next to the ones that come with Atril, no rebuild needed
task user_themes()
    let out be []
    try
        each e in list_dir("~/.atril/themes")
            when not e["is_dir"] and ends_with(lower(e["name"]), ".json") and length(out) < 50
                try
                    let t be json_decode(read_file("~/.atril/themes/" + e["name"]))
                    when type_of(t) == "map"
                        set t["id"] to regex_replace(e["name"], "\\.[Jj][Ss][Oo][Nn]$", "")
                        set out to out + [t]
                recover err
                    set out to out
    recover e
        give []
    give out

-- the folder exists from the start, with a note, so there is somewhere to put one
when not file_info("~/.atril/themes/README.txt")["exists"]
    write_file("~/.atril/themes/README.txt", "Your Atril themes: one .json file per theme, here. Copy one of Atril's (src/ui/themes/ in its\nrepository) and change what you want; a theme only needs what it changes. Its README.md explains\nevery color. Atril lists them in the 'tema' menu, at the bottom of the sidebar (reload the window).\n")

-- ---- a star for Atril on GitHub, from the window (ui/star.js asks once in a while). With the GitHub
-- CLI signed in on this machine one click stars the repository; without it the window opens the
-- repository's page and the star is given there. Only this repository, only these two calls
let REPO be "SYNSEMA/atril"
let REPO_URL be "https://github.com/" + REPO

-- gh's exit code, or nothing when gh is not installed: 0 is yes (204), anything else is no
task gh_code(args)
    try
        let code be run_in(HOME, "gh", args, 15)
        give when code == -1 then nothing otherwise code
    recover e
        give nothing

task publish_meta(meta)
    state_set("sess:" + meta["id"], meta)
    bus_publish("sessions", meta)

-- one session: one pseudo-terminal, kept alive whoever is watching
agent Session
    require exec
    require time
    require file.read
    require file.write("~/.atril/*")
    let p be proc_spawn(cmd, args, {"pty": true, "cols": cols, "rows": rows, "cwd": cwd})
    let inbox be bus_subscribe("in." + sid)
    let meta be {"id": sid, "name": name, "cmd": cmd, "args": args, "cwd": cwd, "space": space_key(cwd), "kind": kind_of(cmd),
        "pid": proc_stats(p)["pid"], "machine": MACHINE, "started": now(), "status": "running",
        "activity": "working", "title": nothing, "exit_code": nothing, "bell": false}
    publish_meta(meta)
    let seq be 0
    let buf be ""
    let last_out be now()
    let screen be ""            -- the last few thousand characters as a person reads them
    let screen_kind be nothing  -- the agent the screen shows running, when it shows one
    let folder be nothing       -- where the shell last said it was
    let kill_at be nothing      -- asked to end: when to stop asking nicely
    -- whatever goes wrong in here, the session must not stay "running" with nobody reading it
    try
        while true
            let ev be select({"p": p, "in": inbox}, 1)
            when kill_at != nothing and now() > kill_at and proc_status(p) == "running"
                proc_kill(p, "KILL")
                set kill_at to nothing
            when ev == nothing
                -- quiet for 3 s: an agent waiting for you, or a shell at its prompt
                when meta["activity"] == "working" and now() - last_out > 3
                    set meta["activity"] to "idle"
                    publish_meta(meta)
            otherwise when ev["name"] == "p"
                when ev["type"] == "exit" and meta["space"] not in apply(load_spaces(), (x) => x["key"])
                    state_delete("sess:" + sid)
                    bus_publish("sessions", {"id": sid, "status": "removed"})
                    bus_publish("out." + sid, {"t": "exit", "code": ev["data"]["exit_code"]})
                    stop
                when ev["type"] == "exit"
                    set meta["status"] to "exited"
                    set meta["activity"] to "idle"
                    set meta["exit_code"] to ev["data"]["exit_code"]
                    set meta["ended"] to now()
                    state_set("tail:" + sid, slice(buf, -65536))
                    publish_meta(meta)
                    bus_publish("out." + sid, {"t": "exit", "code": ev["data"]["exit_code"]})
                    stop
                let chunk be ev["data"]
                set seq to seq + 1
                set buf to buf + chunk
                when length(buf) > KEEP * 2
                    set buf to slice(buf, length(buf) - KEEP)
                set last_out to now()
                bus_publish("out." + sid, {"t": "o", "s": seq, "d": chunk})
                let changed be meta["activity"] != "working"
                set meta["activity"] to "working"
                let t be title_in(chunk)
                when t != nothing and t != meta["title"]
                    set meta["title"] to t
                    set changed to true
                -- what runs now: the title an agent sets, else what was typed at the prompt or what the
                -- agent printed, else the program the session started with
                -- reading the screen is a nicety: a mistake in it must never take the terminal down
                try
                    set screen to slice(screen + strip_ansi(chunk), -6000)
                    let seen be read_screen(screen)
                    when seen != nothing
                        -- Enter after the last prompt: what was typed runs until a new prompt appears, even
                        -- while it has printed nothing but control codes yet (a full-screen program starting)
                        let entered be starts_with(seen["after"], "\r") or starts_with(seen["after"], "\n")
                        when entered
                            let typed be agent_of(seen["typed"])
                            set screen_kind to (when typed != nothing then typed otherwise agent_in_banner(seen["after"]))
                        otherwise
                            set screen_kind to nothing
                        -- the space follows the shell into a repository (or a space you already have)
                        when seen["folder"] != folder
                            set folder to seen["folder"]
                            set meta["here"] to folder
                            let root be git_root(folder)
                            let target be root
                            when target == nothing
                                each sp in load_spaces()
                                    when sp["key"] == space_key(folder)
                                        set target to sp["path"]
                            when target != nothing and space_key(target) != meta["space"]
                                set meta["space"] to add_space(target)
                            set changed to true
                    let tk be kind_from_title(meta["title"])
                    let kind be when tk != nothing then tk otherwise (when screen_kind != nothing then screen_kind otherwise kind_of(cmd))
                    when kind != meta["kind"]
                        set meta["kind"] to kind
                        set changed to true
                recover err
                    set meta["screen_error"] to text(err)
                -- a bell outside a title: the program asks for attention
                when not meta["bell"] and contains(regex_replace(chunk, "\u001b\\][^\u0007]*\u0007", ""), "\u0007")
                    set meta["bell"] to true
                    set changed to true
                when changed
                    publish_meta(meta)
            otherwise
                let m be ev["data"]
                -- a key or a size that reaches a program while it closes fails to write ("the pipe is
                -- being closed"): drop it; the program's exit arrives as its own event and ends the session
                try
                    when m["t"] == "i"
                        proc_send(p, m["d"])
                        when meta["bell"]
                            set meta["bell"] to false
                            publish_meta(meta)
                    otherwise when m["t"] == "r"
                        proc_resize(p, m["cols"], m["rows"])
                    otherwise when m["t"] == "kill"
                        -- TERM first, so a program can close in order; an interactive bash ignores it,
                        -- so KILL if it is still there 3 s later
                        proc_kill(p)
                        set kill_at to now() + 3
                recover err
                    set meta["input_error"] to text(err)
                when m["t"] == "snap"
                    bus_publish("out." + sid, {"t": "snap", "s": seq, "d": buf, "to": m["to"]})
                otherwise when m["t"] == "name"
                    set meta["name"] to m["name"]
                    publish_meta(meta)
    recover err
        set meta["status"] to "exited"
        set meta["activity"] to "idle"
        set meta["ended"] to now()
        set meta["error"] to text(err)
        state_set("tail:" + sid, slice(buf, -65536))
        publish_meta(meta)
        bus_publish("out." + sid, {"t": "exit", "code": nothing})
        proc_close(p)

-- ---- other machines, through SSH ----------------------------------------------------------------
--
-- A machine is "user@host" and a port. Atril has its own key (~/.atril/ssh/id_ed25519) and its own
-- known_hosts. The first connection may ask for the password once: it only adds Atril's public key
-- to that machine's ~/.ssh/authorized_keys, and is never kept. From then on a Link agent per machine
-- keeps a tunnel open (ssh -N -L <local port>:127.0.0.1:7171), checks it every 20 s and opens it
-- again when it drops, waiting a little longer each time (up to 30 s). The window talks to the
-- remote daemons through this one: /api/m/<machine>/… goes through the tunnel with that daemon's key.
--
--   state link:<id>  {status: connecting | up | down, error, machine, since}
--   state mkey:<id>  the remote daemon's key, read through SSH each time the link opens
--   bus   machines   a machine was added or removed, or its link changed
--   bus   link.<id>  {t: "stop"} (forget it) | {t: "kick"} (reconnect now)

let SSH_DIR be replace(HOME, "\\", "/") + "/.atril/ssh"
let SSH_KEY be SSH_DIR + "/id_ed25519"
let SSH_KNOWN be SSH_DIR + "/known_hosts"
-- on the other machine: its daemon up (atr up starts it when it is not), then its key
let REMOTE_UP be "\"$HOME/.local/bin/atr\" up >/dev/null 2>&1; cat \"$HOME/.atril/daemon.json\""

-- Windows has OpenSSH in System32; elsewhere ssh is on the PATH
task ssh_tool(name)
    when platform()["os"] == "windows"
        let sys be "C:\\Windows\\System32\\OpenSSH\\" + name + ".exe"
        when file_info(sys)["exists"]
            give sys
    give name

task load_machines()
    try
        let list be json_decode(read_file("~/.atril/machines.json"))
        give when type_of(list) == "list" then list otherwise []
    recover e
        give []

task save_machines(list)
    write_file("~/.atril/machines.json", json_encode(list))

task machine_by_id(mid)
    each m in load_machines()
        when m["id"] == mid
            give m
    give nothing

-- every connection to m: Atril's key and known hosts, never a prompt, a keepalive that notices a dead line
task ssh_opts(m)
    give ["-p", text(m["port"]), "-i", SSH_KEY, "-o", "IdentitiesOnly=yes", "-o", "UserKnownHostsFile=" + SSH_KNOWN,
        "-o", "StrictHostKeyChecking=accept-new", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
        "-o", "ServerAliveInterval=15", "-o", "ServerAliveCountMax=3"]

-- a program run to its end without a window. On Windows this daemon has no console, and a console
-- program it starts with pipes gets a console window of its own (ssh.exe popping up); in a
-- pseudo-terminal it has none. Gives {exit_code, out}: what it printed, stdout and stderr together
task run_quiet(cmd, args, timeout)
    let p be proc_spawn(cmd, args, {"pty": true, "cols": 4000, "rows": 50})
    let out be ""
    let code be nothing
    let deadline be now() + timeout
    while code == nothing and now() < deadline
        let ev be proc_recv(p, 1)
        when ev != nothing
            when ev["type"] == "exit"
                set code to ev["data"]["exit_code"]
            otherwise
                set out to out + ev["data"]
    proc_close(p)
    give {"exit_code": (when code == nothing then -1 otherwise code), "out": strip_ansi(out)}

-- Atril's key pair, made the first time; gives the public half
task ensure_key()
    when not file_info(SSH_KEY)["exists"]
        write_file("~/.atril/ssh/README", "Atril's own SSH key. Its public half is in the authorized_keys of the machines you connected.\n")
        run_quiet(ssh_tool("ssh-keygen"), ["-q", "-t", "ed25519", "-N", "", "-C", "atril@" + MACHINE, "-f", SSH_KEY], 30)
    give trim(read_file(SSH_KEY + ".pub"))

-- the line a machine runs to accept Atril's key (once, idempotent)
task add_key_cmd(pub)
    give "umask 077; mkdir -p ~/.ssh; touch ~/.ssh/authorized_keys; grep -qxF '" + pub + "' ~/.ssh/authorized_keys || echo '" + pub + "' >> ~/.ssh/authorized_keys; echo ATRIL-KEY-OK"

task try_batch(m)
    try
        let r be run_quiet(ssh_tool("ssh"), ssh_opts(m) + [m["target"], "echo atril-ok"], 25)
        give contains(r["out"], "atril-ok")
    recover e
        give false

-- the other daemon running, and its key: {ok, conf} or {ok: false, error}
task remote_up(m)
    try
        let r be run_quiet(ssh_tool("ssh"), ssh_opts(m) + [m["target"], REMOTE_UP], 40)
        let found be regex_capture(r["out"], "(\\{[^\r\n]*\\})")
        let conf be when found == nothing then nothing otherwise json_decode(found[0], nothing)
        when r["exit_code"] != 0 or conf == nothing or type_of(conf) != "map" or get(conf, "token") == nothing
            give {"ok": false, "error": trim(r["out"])}
        give {"ok": true, "conf": conf}
    recover e
        give {"ok": false, "error": text(e)}

-- something already listens on that port of this machine (Windows lets two listen on one port, so a
-- failed bind cannot be trusted to say it)
task port_taken(port)
    try
        let r be http_get("http://127.0.0.1:" + text(port) + "/", {}, nothing, 3)
        give (status of r) != 0
    recover e
        give false

-- a free local port for machine mid, starting at the one it had; remembered when it changes
task free_port_for(mid, start)
    let others be apply(where(load_machines(), (x) => x["id"] != mid), (x) => x["local_port"])
    let p be start
    while p in others or port_taken(p)
        set p to p + 1
    when p != start
        save_machines(apply(load_machines(), (x) => when x["id"] == mid then {"id": x["id"], "name": x["name"], "target": x["target"], "port": x["port"], "local_port": p} otherwise x))
    give p

task answers(port, key)
    try
        let r be http_get("http://127.0.0.1:" + text(port) + "/api/info", {"Authorization": "Bearer " + key}, nothing, 5)
        give ok of r
    recover e
        give false

task set_link(mid, status, err, remote_machine)
    let prev be state_get("link:" + mid, {})
    let rm be when remote_machine != nothing then remote_machine otherwise get(prev, "machine")
    state_set("link:" + mid, {"status": status, "error": err, "machine": rm, "since": now(), "version": get(prev, "version")})
    bus_publish("machines", {"id": mid})

task machines_view()
    let out be []
    each m in load_machines()
        let l be state_get("link:" + m["id"], {})
        set out to out + [{"id": m["id"], "name": m["name"], "target": m["target"], "port": m["port"],
            "status": get(l, "status", "connecting"), "error": get(l, "error"), "machine": get(l, "machine"), "since": get(l, "since"),
            "version": get(l, "version")}]
    give out

-- where a remote daemon answers here, and its key; nothing while its link is not up
task remote_of(mid)
    let m be machine_by_id(mid)
    let key be state_get("mkey:" + mid)
    when m == nothing or key == nothing or get(state_get("link:" + mid, {}), "status") != "up"
        give nothing
    give {"base": "http://127.0.0.1:" + text(m["local_port"]), "ws": "ws://127.0.0.1:" + text(m["local_port"]), "key": key}

-- one machine's link: open it, hold it, open it again, until the machine is forgotten
agent Link
    require exec
    require time
    require file.read
    require net("127.0.0.1")
    let inbox be bus_subscribe("link." + mid)
    let alive be true
    let backoff be 1
    while alive
        try
            let m be machine_by_id(mid)
            when m == nothing
                set alive to false
            otherwise
                set_link(mid, "connecting", nothing, nothing)
                let up be remote_up(m)
                when not up["ok"]
                    set_link(mid, "down", up["error"], nothing)
                otherwise
                    let key be up["conf"]["token"]
                    state_set("mkey:" + mid, key)
                    let lp be free_port_for(mid, m["local_port"])
                    let t be proc_spawn(ssh_tool("ssh"), ssh_opts(m) + ["-N", "-o", "ExitOnForwardFailure=yes", "-L", text(lp) + ":127.0.0.1:7171", m["target"]], {"pty": true, "cols": 400, "rows": 20})
                    let ready be false
                    let tries be 0
                    while not ready and tries < 30 and proc_status(t) == "running"
                        sleep(0.5)
                        set ready to answers(lp, key)
                        set tries to tries + 1
                    when not ready
                        let said be ""
                        let ev be proc_recv(t, 0.2)
                        while ev != nothing and ev["type"] != "exit"
                            set said to said + ev["data"] + " "
                            set ev to proc_recv(t, 0.2)
                        proc_close(t)
                        set said to trim(strip_ansi(said))
                        set_link(mid, "down", "no se abrió el túnel: " + said, nothing)
                        -- the local port is taken (another program, another Atril): the next free one,
                        -- remembered for this machine
                        when regex_find_all(said, "(Address already in use|cannot listen|bind)")
                            let others be apply(where(load_machines(), (x) => x["id"] != mid), (x) => x["local_port"])
                            let next be lp + 1
                            while next in others
                                set next to next + 1
                            save_machines(apply(load_machines(), (x) => when x["id"] == mid then {"id": x["id"], "name": x["name"], "target": x["target"], "port": x["port"], "local_port": next} otherwise x))
                            set backoff to 1
                    otherwise
                        set_link(mid, "up", nothing, get(up["conf"], "machine"))
                        -- which Atril answers there: an older one can be updated from the machine's menu
                        try
                            let info be json of http_get("http://127.0.0.1:" + text(lp) + "/api/info", {"Authorization": "Bearer " + key}, nothing, 5)
                            let l be state_get("link:" + mid, {})
                            set l["version"] to get(info, "version")
                            state_set("link:" + mid, l)
                            bus_publish("machines", {"id": mid})
                        recover e
                            set e to e
                        set backoff to 1
                        let fails be 0
                        let holding be true
                        while holding
                            let ev be select({"t": t, "in": inbox}, 20)
                            when ev == nothing
                                when answers(lp, key)
                                    set fails to 0
                                otherwise
                                    set fails to fails + 1
                                    when fails >= 2
                                        set holding to false
                            otherwise when ev["name"] == "t"
                                when ev["type"] == "exit"
                                    set holding to false
                            otherwise when ev["data"]["t"] == "stop"
                                set holding to false
                                set alive to false
                            otherwise when ev["data"]["t"] == "kick"
                                set holding to false
                        proc_close(t)
                        when alive
                            set_link(mid, "down", "the connection dropped; opening it again", nothing)
        recover err
            set_link(mid, "down", text(err), nothing)
        when alive
            -- wait before trying again, but a "forget" or "reconnect now" cuts the wait short
            let ev be bus_recv(inbox, backoff)
            when ev != nothing and ev["data"]["t"] == "stop"
                set alive to false
            set backoff to when backoff >= 16 then 30 otherwise backoff * 2
    state_delete("link:" + mid)
    state_delete("mkey:" + mid)

task start_links()
    each m in load_machines()
        spawn Link with mid = m["id"]

task tell(sock, msg)
    ws_send(sock, json_encode({"t": "step", "msg": msg}))

-- the password, once, to leave Atril's key on the machine: ssh in a pseudo-terminal, the window types
-- the password when ssh asks for it. Gives nothing when the key was added, else what went wrong
task password_once(sock, m, pub)
    let p be proc_spawn(ssh_tool("ssh"), ["-p", text(m["port"]), "-o", "PubkeyAuthentication=no",
        "-o", "PreferredAuthentications=password,keyboard-interactive", "-o", "NumberOfPasswordPrompts=3",
        "-o", "UserKnownHostsFile=" + SSH_KNOWN, "-o", "StrictHostKeyChecking=accept-new", "-o", "ConnectTimeout=10",
        m["target"], add_key_cmd(pub)], {"pty": true, "cols": 200, "rows": 20})
    let seen be ""
    let attempts be 0
    let deadline be now() + 180
    while now() < deadline
        let ev be select({"p": p, "ui": sock}, 5)
        when ev != nothing and ev["name"] == "p"
            when ev["type"] == "exit"
                proc_close(p)
                when contains(seen, "ATRIL-KEY-OK")
                    give nothing
                when contains(seen, "Permission denied")
                    give "Contraseña incorrecta, o esa máquina no acepta contraseñas."
                give "No se pudo entrar: " + slice(trim(regex_replace(seen, "\\s+", " ")), -300)
            set seen to slice(seen + strip_ansi(ev["data"]), -4000)
            when contains(seen, "ATRIL-KEY-OK")
                proc_close(p)
                give nothing
            -- a prompt after an answer means the answer was wrong (ssh may also move on to another method
            -- that asks the same): ask again, three times at most
            when regex_find_all(seen, "[Pp]assword[^\r\n]*: *$")
                when attempts >= 3
                    proc_close(p)
                    give "Contraseña incorrecta (3 intentos)."
                set seen to ""
                set attempts to attempts + 1
                let msg be when attempts == 1 then "Contraseña de " + m["target"] otherwise "No era esa. Contraseña de " + m["target"] + " (intento " + text(attempts) + " de 3)"
                ws_send(sock, json_encode({"t": "ask", "what": "password", "msg": msg, "retry": attempts > 1}))
        otherwise when ev != nothing and ev["name"] == "ui"
            when ev["type"] == "close"
                proc_close(p)
                give "Cancelado."
            let msg be json_decode(ev["data"], nothing)
            when msg != nothing and type_of(msg) == "map" and type_of(get(msg, "password")) == "text"
                set seen to ""
                proc_send(p, msg["password"] + "\r")
                set msg to nothing
                tell(sock, "Probando la contraseña…")
    proc_close(p)
    give "Tiempo agotado esperando la contraseña."

-- ---- installing Atril on a machine that has none, through the SSH link
--
-- The sources travel from this computer, not from the internet (the repository may be private, the
-- machine may not reach GitHub): ssh -R gives that machine a port on its own 127.0.0.1 that leads
-- here, and its curl fetches each file with a key made for this one install. The engine comes from
-- its official installer when the machine has none. Then the machine runs install.sh, as a person would.

let SOURCES be ["atrild.syn", "atr.syn", "window.syn", "install.sh", "ui/index.html", "ui/app.js", "ui/files.js", "ui/star.js", "ui/theme.js", "ui/app.css",
    "ui/themes/oscuro.json", "ui/themes/claro.json", "ui/themes/papel.json", "ui/themes/contraste.json", "ui/icon.svg",
    "ui/vendor/xterm.min.js", "ui/vendor/xterm.css", "ui/vendor/addon-fit.min.js", "ui/vendor/highlight.min.js"]

task install_script(port, key)
    let fetch_each be "for f in " + join(SOURCES, " ") + "; do curl -fsS -H 'Authorization: Bearer " + key + "' \"http://127.0.0.1:" + text(port) + "/api/source/$f\" -o \"$D/$f\"; done; "
    give join([
        "set -e; export PATH=\"$HOME/.local/bin:$PATH\"; ",
        "command -v curl >/dev/null 2>&1 || { echo 'ATRIL-FAIL esa máquina no tiene curl: instalalo y volvé a conectar'; exit 3; }; ",
        "if ! command -v synsema >/dev/null 2>&1; then echo 'ATRIL-STEP Instalando el motor de Synsema'; curl -fsSL https://synsema.com/install.sh | sh; fi; ",
        "D=\"$HOME/.atril/src\"; rm -rf \"$D\"; mkdir -p \"$D/ui/vendor\" \"$D/ui/themes\"; ",
        "echo 'ATRIL-STEP Copiando Atril desde esta computadora'; " + fetch_each,
        "echo 'ATRIL-STEP Compilando e instalando Atril (uno o dos minutos)'; cd \"$D\" && sh install.sh; echo ATRIL-INSTALL-OK"], "")

-- gives nothing when Atril got installed, else what went wrong
task install_remote(sock, m)
    let key be token(24)
    let port be 20000 + floor(random() * 30000)
    state_set("install_key", key)
    let p be proc_spawn(ssh_tool("ssh"), ssh_opts(m) + ["-o", "ExitOnForwardFailure=yes", "-R", text(port) + ":127.0.0.1:" + text(PORT), m["target"], install_script(port, key)],
        {"pty": true, "cols": 400, "rows": 50})
    let out be ""
    let told be 0
    let code be nothing
    let deadline be now() + 900
    while code == nothing and now() < deadline
        let ev be proc_recv(p, 2)
        when ev != nothing
            when ev["type"] == "exit"
                set code to ev["data"]["exit_code"]
            otherwise
                set out to out + strip_ansi(ev["data"])
                let steps be regex_find_all(out, "ATRIL-STEP [^\r\n]*")
                while told < length(steps)
                    tell(sock, replace(steps[told], "ATRIL-STEP ", ""))
                    set told to told + 1
    proc_close(p)
    state_delete("install_key")
    when contains(out, "ATRIL-INSTALL-OK")
        give nothing
    let failed be regex_capture(out, "ATRIL-FAIL ([^\r\n]*)")
    when failed != nothing
        give failed[0]
    give "La instalación no terminó: " + slice(trim(regex_replace(out, "\\s+", " ")), -400)

-- "Conectar máquina": from user@host to a link that stays open. Gives {ok, id, name} or {error}
task connect_flow(sock, req)
    let target be trim(text(get(req, "target", "")))
    let port be int(get(req, "port", 22), fallback = 22)
    when not regex_find_all(target, "^[A-Za-z0-9._-]+@[A-Za-z0-9._:-]+$")
        give {"error": "Escribí usuario@ip, por ejemplo root@203.0.113.7"}
    when port < 1 or port > 65535
        give {"error": "El puerto va de 1 a 65535 (SSH suele ser 22)."}
    each known in load_machines()
        when known["target"] == target and known["port"] == port
            give {"error": "Esa máquina ya está conectada.", "id": known["id"]}
    let m be {"id": "", "target": target, "port": port}
    tell(sock, "Conectando con " + target)
    let pub be ensure_key()
    -- one trip when Atril's key already opens the door: that trip also asks for the other daemon
    let up be remote_up(m)
    when not up["ok"] and regex_find_all(text(up["error"]), "(Could not resolve|Connection refused|timed out|No route to host|Network is unreachable)")
        give {"error": "No llego a " + target + ": " + trim(text(up["error"]))}
    when not up["ok"] and regex_find_all(text(up["error"]), "REMOTE HOST IDENTIFICATION HAS CHANGED|Host key verification failed")
        give {"error": "La identidad de " + target + " cambió desde la última vez. Si reinstalaste ese servidor, borrá su línea de ~/.atril/ssh/known_hosts; si no, no conectes."}
    when not up["ok"] and regex_find_all(text(up["error"]), "Permission denied")
        -- your own SSH setup (a key, an agent) may already open the door: then it leaves Atril's key
        tell(sock, "La llave de Atril todavía no está en esa máquina")
        let own be nothing
        try
            set own to run_quiet(ssh_tool("ssh"), ["-p", text(port), "-o", "BatchMode=yes", "-o", "UserKnownHostsFile=" + SSH_KNOWN,
                "-o", "StrictHostKeyChecking=accept-new", "-o", "ConnectTimeout=10", target, add_key_cmd(pub)], 30)
        recover e
            set own to {"out": text(e)}
        when not contains(own["out"], "ATRIL-KEY-OK")
            tell(sock, "Esta máquina pide contraseña: la uso una sola vez, para dejar la llave de Atril. No se guarda.")
            let res be password_once(sock, m, pub)
            when res != nothing
                give {"error": res}
        tell(sock, "Probando la llave de Atril")
        when not try_batch(m)
            give {"error": "La llave quedó en la máquina pero no permite entrar. ¿Ese servidor acepta llaves (PubkeyAuthentication yes)?"}
        tell(sock, "Buscando Atril en esa máquina")
        set up to remote_up(m)
    when not up["ok"]
        -- not there (or not starting): offer to install it, through this same link
        ws_send(sock, json_encode({"t": "ask", "what": "install", "msg": "Atril no está instalado en " + target + ". ¿Lo instalo? Va en ese usuario (~/.local), sin root; trae el motor de Synsema si falta. Tarda uno o dos minutos."}))
        let answer be ws_recv(sock, 900)
        let said be when answer == nothing or answer["type"] != "text" then nothing otherwise json_decode(answer["data"], nothing)
        when type_of(said) != "map" or get(said, "install") != true
            give {"error": "Sin Atril en esa máquina no hay sesiones que sobrevivan al corte. Cuando quieras, conectala de nuevo y elegí instalar."}
        let failed be install_remote(sock, m)
        when failed != nothing
            give {"error": failed}
        tell(sock, "Atril instalado. Arrancándolo")
        set up to remote_up(m)
        when not up["ok"]
            give {"error": "Se instaló, pero no arranca: " + slice(text(up["error"]), 0, 300)}
    let list be load_machines()
    let used be apply(list, (x) => x["local_port"])
    let lp be 7301
    while lp in used
        set lp to lp + 1
    let mid be "m" + text(lp - 7300)
    let name be trim(text(get(req, "name", "")))
    when name == ""
        set name to text(get(up["conf"], "machine", regex_replace(target, "^.*@", "")))
    save_machines(list + [{"id": mid, "name": name, "target": target, "port": port, "local_port": lp}])
    spawn Link with mid = mid
    bus_publish("machines", {"id": mid})
    give {"ok": true, "id": mid, "name": name}

-- a window's socket to a remote daemon's socket, both ways, until either closes
task pipe_ws(sock, url, key)
    let up be nothing
    try
        set up to ws_connect(url, {"Authorization": "Bearer " + key}, {"timeout": 10})
    recover e
        give nothing
    while true
        let ev be select({"ui": sock, "up": up}, 30)
        when ev != nothing
            when ev["type"] == "close"
                when ev["name"] == "ui"
                    ws_close(up)
                give nothing
            when ev["name"] == "ui"
                ws_send(up, ev["data"])
            otherwise
                ws_send(sock, ev["data"])

-- a request of the window to a remote daemon, answered as that daemon answered it
task proxy_http(mid, method, rest, q, body)
    let r be remote_of(mid)
    when r == nothing
        give fail(503, "that machine is not connected right now")
    let h be {"Authorization": "Bearer " + r["key"], "Content-Type": "application/json"}
    let url be r["base"] + "/api/" + rest
    let res be nothing
    when method == "GET"
        set res to http_get(url, h, q, 30)
    otherwise when method == "POST"
        set res to http_post(url, body, h, 30)
    otherwise
        set res to http_delete(url, h, 30)
    give respond(body of res, "application/json", status of res)

-- ---- agents running outside Atril
--
-- An agent started in another terminal (or over plain SSH) is not Atril's: its screen lives in that
-- terminal. Atril can still say it exists. Every 20 s the processes of this machine are listed and the
-- agents among them kept, minus those that run inside an Atril session (any ancestor is a session's
-- shell) and an agent's own helpers (a parent of the same kind). Read only: nothing is attached.
--
--   state outside   [{pid, kind, age, cwd}]      bus outside   the list changed

-- the agent a command line runs, or nothing: its program, or what an interpreter (node, bun…) runs
task agent_in_cmdline(cmd)
    let words be where(split(trim(text(cmd)), " "), (w) => w != "")
    when length(words) == 0
        give nothing
    let first be lower(regex_replace(regex_replace(replace(words[0], "\"", ""), "^.*[\\\\/]", ""), "\\.(exe|cmd|bat)$", ""))
    when first in AGENTS and first != "ollama"
        give first
    when first in ["node", "bun", "deno", "python", "python3"] and length(words) > 1
        let script be lower(regex_replace(regex_replace(replace(words[1], "\"", ""), "^.*[\\\\/]", ""), "\\.(js|mjs|cjs|py)$", ""))
        when script in AGENTS and script != "ollama"
            give script
        -- npm's shims run …/node_modules/@openai/codex/bin/codex.js: the package names it too
        each k in AGENTS
            when k != "ollama" and contains(lower(words[1]), "/" + k + "/") or contains(lower(words[1]), "\\" + k + "\\")
                give k
    give nothing

-- [{pid, ppid, age, cmd}] of every process here
task processes()
    let out be []
    when platform()["os"] == "windows"
        let r be run_quiet("powershell", ["-NoProfile", "-Command", "Get-CimInstance Win32_Process | ForEach-Object { '{0}|{1}|{2}' -f $_.ProcessId, $_.ParentProcessId, $_.CommandLine }"], 30)
        each line in split(r["out"], "\n")
            let c be regex_capture(trim(line), "^([0-9]+)\\|([0-9]+)\\|(.*)$")
            when c != nothing
                set out to out + [{"pid": int(c[0]), "ppid": int(c[1]), "age": nothing, "cmd": c[2]}]
    otherwise
        let r be run_quiet("ps", ["-eo", "pid=,ppid=,etimes=,args="], 20)
        each line in split(r["out"], "\n")
            let c be regex_capture(line, "^\\s*([0-9]+)\\s+([0-9]+)\\s+([0-9]+)\\s+(.*)$")
            when c != nothing
                set out to out + [{"pid": int(c[0]), "ppid": int(c[1]), "age": int(c[2]), "cmd": trim(c[3])}]
    give out

task scan_outside()
    let own be apply(where(sessions(), (x) => x["status"] == "running"), (x) => x["pid"])
    let procs be processes()
    let parent be {}
    let kind be {}
    each pr in procs
        set parent[text(pr["pid"])] to pr["ppid"]
        set kind[text(pr["pid"])] to agent_in_cmdline(pr["cmd"])
    let found be []
    each pr in procs
        let k be kind[text(pr["pid"])]
        when k != nothing and kind[text(pr["ppid"])] != k
            -- inside Atril when any ancestor is a session's shell
            let inside be false
            let up be pr["ppid"]
            let depth be 0
            while up != nothing and up > 1 and depth < 40 and not inside
                when up in own
                    set inside to true
                set up to get(parent, text(up))
                set depth to depth + 1
            when not inside and pr["pid"] not in own
                set found to found + [{"pid": pr["pid"], "kind": k, "age": pr["age"], "cwd": nothing}]
    -- where each one works (Linux: /proc/<pid>/cwd)
    when length(found) > 0 and platform()["os"] == "linux"
        let r be run_quiet("sh", ["-c", "for p in " + join(apply(found, (f) => text(f["pid"])), " ") + "; do echo \"$p $(readlink /proc/$p/cwd)\"; done"], 10)
        let where_is be {}
        each line in split(r["out"], "\n")
            let c be regex_capture(trim(line), "^([0-9]+) (.+)$")
            when c != nothing
                set where_is[c[0]] to c[1]
        set found to apply(found, (f) => {"pid": f["pid"], "kind": f["kind"], "age": f["age"], "cwd": get(where_is, text(f["pid"]))})
    give found

task refresh_outside()
    try
        let list be scan_outside()
        when json_encode(list) != json_encode(state_get("outside", []))
            state_set("outside", list)
            bus_publish("outside", {"n": length(list)})
    recover e
        state_set("outside_error", text(e))

-- what a window may send to a session, and nothing else: keys, or a new size
task clean_input(m)
    when type_of(m) != "map"
        give nothing
    when get(m, "t") == "i" and type_of(get(m, "d")) == "text"
        give {"t": "i", "d": m["d"]}
    when get(m, "t") == "r"
        let c be int(get(m, "cols"), fallback = 0)
        let r be int(get(m, "rows"), fallback = 0)
        when c >= 2 and c <= 1000 and r >= 2 and r <= 500
            give {"t": "r", "cols": c, "rows": r}
    give nothing

task sessions()
    let all be state_all()
    let out be []
    each k in keys(all)
        when starts_with(k, "sess:")
            set out to out + [all[k]]
    give sort_by(out, (s) => s["started"])

-- a session by id, name or pid
-- several with one name (a session restarted): the running one, else the newest
task find_session(ref)
    let found be nothing
    each s in sessions()
        when s["id"] == ref or s["name"] == ref or text(s["pid"]) == ref
            when found == nothing or s["status"] == "running" or found["status"] != "running"
                set found to s
    give found

-- cookies are per host, not per port: a tunnel to another machine on 127.0.0.1:7172 keeps its own
task cookie_name(host)
    give "atril_" + regex_replace(host, "^.*:", "")

-- who may talk to the daemon: same machine, same origin, the token
task check(tok, request)
    let h be request.headers
    let host be text(get(h, "host", ""))
    when not regex_find_all(host, "^(127\\.0\\.0\\.1|localhost)(:[0-9]+)?$")
        give nothing
    when get(h, "origin") != nothing and get(h, "origin") != "http://" + host
        give nothing
    let given be tok
    when given == nothing or given == ""
        set given to get(request.cookies, cookie_name(host))
    when given == nothing or not constant_time_eq(given, TOKEN)
        give nothing
    give {"name": "owner"}

let LOGIN_PAGE be "<!doctype html><meta charset=utf-8><title>Atril</title><body style='background:#0c0c0d;color:#9a9aa2;font:14px ui-monospace,monospace;padding:40px'>Open Atril with <b style='color:#e6e6ea'>atr open</b> — it brings the key of this computer.</body>"

serve on 7171
    bind "127.0.0.1"
    auth with check
    static "./ui"

    route "GET /api/hello"
        give respond(LOGIN_PAGE, "text/html")

    route "POST /api/login" requires auth
        give set_cookie({"ok": true, "machine": MACHINE, "version": VERSION}, cookie_name(text(get(request.headers, "host", ""))), TOKEN, {"secure": false, "same_site": "Strict", "http_only": true})

    -- `atr down`: every session ends with the daemon
    route "POST /api/shutdown" requires auth
        shutdown("atr down")
        give {"ok": true}

    -- `atr open` with a window already open: show it there instead of opening another one
    route "POST /api/show" requires auth
        let b be json of request
        let ref be when b == nothing then nothing otherwise get(b, "ref")
        give {"shown": bus_publish("ui", {"ref": ref}) > 0}

    route "GET /api/dirs" requires auth
        try
            give list_dirs(get(query, "path", ""))
        recover e
            give fail(400, "No puedo abrir esa carpeta: " + text(e))

    route "GET /api/dirs/suggest" requires auth
        give {"home": HOME, "repos": suggestions()}

    -- a title for a session: what you will do there, to remember it and to find it
    route "POST /api/sessions/:ref/rename" requires auth
        let s be find_session(params.ref)
        when s == nothing
            give not_found("no session " + params.ref)
        let b be json of request
        let nm be trim(text(when b == nothing then "" otherwise get(b, "name", "")))
        when nm == "" or length(nm) > 80 or regex_find_all(nm, "[\u0000-\u001f]")
            give fail(400, "El título va de 1 a 80 caracteres, en una línea.")
        when s["status"] == "running"
            bus_publish("in." + s["id"], {"t": "name", "name": nm})
        otherwise
            set s["name"] to nm
            publish_meta(s)
        give {"ok": true, "id": s["id"], "name": nm}

    -- agents running here outside Atril (see scan_outside)
    route "GET /api/outside" requires auth
        give state_get("outside", [])

    route "GET /api/spaces" requires auth
        give spaces_view()

    -- a new space: a folder that exists
    route "POST /api/spaces" requires auth
        let b be json of request
        let path be when b == nothing then "" otherwise text(get(b, "path", ""))
        when path == "" or not file_info(path)["is_dir"]
            give fail(400, "No existe la carpeta " + path)
        give {"key": add_space(path)}

    -- forget a space. What still runs in it ends first when asked ({stop: true}); otherwise that is
    -- refused, so nothing dies by surprise. Ended sessions of the space go with it
    route "POST /api/spaces/forget" requires auth
        let b be json of request
        let key be when b == nothing then "" otherwise space_key(get(b, "key", ""))
        let stop_them be b != nothing and get(b, "stop") == true
        each s in sessions()
            when get(s, "space") == key
                when s["status"] == "running" and not stop_them
                    give fail(409, "Todavía corre algo en ese space.")
                when s["status"] == "running"
                    bus_publish("in." + s["id"], {"t": "kill"})
                otherwise
                    state_delete("sess:" + s["id"])
                    state_delete("tail:" + s["id"])
                    bus_publish("sessions", {"id": s["id"], "status": "removed"})
        save_spaces(where(load_spaces(), (sp) => sp["key"] != key))
        bus_publish("spaces", {"changed": key})
        give {"ok": true}

    -- ---- the files of a space (the panel on the right), read only
    -- the folders open in the panel, what git says changed, and how the file on screen is now (so the
    -- panel knows when to read it again): one trip each few seconds
    route "POST /api/files/tree" requires auth
        let b be json of request
        let root be space_root(when b == nothing then "" otherwise get(b, "space", ""))
        when root == nothing
            give not_found("Ese space no está en esta máquina.")
        let asked be get(b, "dirs", ["."])
        let dirs be {}
        each d in slice(when type_of(asked) == "list" then asked otherwise ["."], 0, 200)
            let rel be clean_rel(d)
            when rel != nothing
                try
                    set dirs[rel] to list_entries(root, rel)
                recover e
                    set dirs[rel] to nothing
        let st be files_status(root)
        let watch be nothing
        let w be clean_rel(get(b, "watch", ""))
        when w != nothing and w != "."
            let info be file_info(abs_in(root, w))
            set watch to {"path": w, "exists": info["exists"], "modified": get(info, "modified"), "size": get(info, "size")}
        give {"root": root, "repo": st["repo"], "branch": st["branch"], "changes": st["changes"], "dirs": dirs, "watch": watch}

    route "GET /api/files/read" requires auth
        let root be space_root(get(query, "space", ""))
        let rel be clean_rel(get(query, "path", ""))
        when root == nothing or rel == nothing or rel == "."
            give not_found("No hay tal archivo en ese space.")
        give file_read(root, rel)

    route "GET /api/files/diff" requires auth
        let root be space_root(get(query, "space", ""))
        let rel be clean_rel(get(query, "path", ""))
        when root == nothing or rel == nothing or rel == "."
            give not_found("No hay tal archivo en ese space.")
        give {"path": rel, "diff": file_diff(root, rel)}

    -- ---- other machines
    route "GET /api/machines" requires auth
        give machines_view()

    route "GET /api/machines/connect" requires auth
        timeout none
        socket
            let first be ws_recv(socket, 120)
            let req be when first == nothing or first["type"] != "text" then nothing otherwise json_decode(first["data"], nothing)
            let result be when type_of(req) == "map" then connect_flow(socket, req) otherwise {"error": "nothing to connect"}
            ws_send(socket, json_encode({"t": "done", "result": result}))

    route "POST /api/machines/:mid/forget" requires auth
        bus_publish("link." + params.mid, {"t": "stop"})
        save_machines(where(load_machines(), (m) => m["id"] != params.mid))
        state_delete("link:" + params.mid)
        state_delete("mkey:" + params.mid)
        bus_publish("machines", {"id": params.mid})
        give {"ok": true}

    -- install this computer's Atril on that machine again (an update); its sessions end
    route "GET /api/machines/:mid/update" requires auth
        timeout none
        socket
            let m be machine_by_id(params.mid)
            let failed be when m == nothing then "no such machine" otherwise install_remote(socket, m)
            when failed == nothing
                bus_publish("link." + params.mid, {"t": "kick"})
            ws_send(socket, json_encode({"t": "done", "result": (when failed == nothing then {"ok": true, "name": m["name"]} otherwise {"error": failed})}))

    route "POST /api/machines/:mid/reconnect" requires auth
        bus_publish("link." + params.mid, {"t": "kick"})
        give {"ok": true}

    route "GET /api/m/:mid/events" requires auth
        timeout none
        socket
            let r be remote_of(params.mid)
            when r != nothing
                pipe_ws(socket, r["ws"] + "/api/events", r["key"])

    route "GET /api/m/:mid/sessions/:ref/attach" requires auth
        timeout none
        socket
            let r be remote_of(params.mid)
            when r != nothing
                pipe_ws(socket, r["ws"] + "/api/sessions/" + params.ref + "/attach", r["key"])

    route "GET /api/m/:mid/*rest" requires auth
        give proxy_http(params.mid, "GET", params.rest, query, nothing)

    route "POST /api/m/:mid/*rest" requires auth
        give proxy_http(params.mid, "POST", params.rest, nothing, read_body())

    route "DELETE /api/m/:mid/*rest" requires auth
        give proxy_http(params.mid, "DELETE", params.rest, nothing, nothing)

    -- the sources, for a machine installing Atril through `ssh -R` (see install_remote): only with the
    -- key of an install in progress, only from this machine's loopback, only the files in SOURCES
    route "GET /api/source/*path"
        let key be state_get("install_key")
        let h be text(get(request.headers, "authorization", ""))
        let host be text(get(request.headers, "host", ""))
        when key == nothing or not constant_time_eq(h, "Bearer " + key) or not regex_find_all(host, "^(127\\.0\\.0\\.1|localhost)(:[0-9]+)?$")
            give fail(401, "unauthorized")
        when params.path not in SOURCES
            give not_found("no such file")
        give respond(read_file(params.path), "text/plain")

    -- starred: true / false, or nothing when gh cannot tell (not installed or not signed in)
    route "GET /api/star" requires auth
        let code be gh_code(["api", "user/starred/" + REPO, "--silent"])
        give {"starred": when code == nothing then nothing otherwise code == 0, "url": REPO_URL}

    route "POST /api/star" requires auth
        let code be gh_code(["api", "-X", "PUT", "user/starred/" + REPO, "--silent"])
        give {"starred": code == 0, "url": REPO_URL}

    route "GET /api/themes" requires auth
        give {"themes": user_themes()}   -- in a map: a bare list would come back paged

    route "GET /api/info" requires auth
        give {"machine": MACHINE, "os": platform()["os"], "version": VERSION}

    route "GET /api/sessions" requires auth
        give sessions()

    route "POST /api/sessions" requires auth
        let b be json of request
        when b == nothing
            set b to {}
        let sh be default_shell()
        let cmd be get(b, "cmd")
        let args be get(b, "args")
        when cmd == nothing or cmd == ""
            set cmd to sh["cmd"]
            set args to sh["args"]
        when args == nothing
            set args to []
        let n be state_incr("next_id")
        let sid be "s" + text(n)
        let nm be get(b, "name")
        when nm == nothing or nm == ""
            set nm to kind_of(cmd) + "-" + text(n)
        let cwd be get(b, "cwd")
        when cwd == nothing or cwd == ""
            set cwd to HOME
        set cwd to real_case(cwd)
        add_space(cwd)
        let cols be int(get(b, "cols"), fallback = 120)
        let rows be int(get(b, "rows"), fallback = 32)
        spawn Session with sid = sid, name = nm, cmd = cmd, args = args, cwd = cwd, cols = cols, rows = rows
        -- wait until the agent published itself, so the answer carries the pid
        let tries be 0
        while state_get("sess:" + sid) == nothing and tries < 50
            sleep(0.05)
            set tries to tries + 1
        give state_get("sess:" + sid, {"id": sid, "name": nm, "status": "starting"})

    route "POST /api/sessions/:ref/kill" requires auth
        let s be find_session(params.ref)
        when s == nothing
            give not_found("no session " + params.ref)
        bus_publish("in." + s["id"], {"t": "kill"})
        give {"ok": true, "id": s["id"]}

    route "DELETE /api/sessions/:ref" requires auth
        let s be find_session(params.ref)
        when s == nothing
            give not_found("no session " + params.ref)
        when s["status"] == "running"
            give fail(409, "Esa sesión todavía corre: terminala primero.")
        state_delete("sess:" + s["id"])
        state_delete("tail:" + s["id"])
        bus_publish("sessions", {"id": s["id"], "status": "removed"})
        give {"ok": true}

    -- the sidebar: every change of every session
    route "GET /api/events" requires auth
        timeout none
        socket
            let sub be bus_subscribe(["sessions", "ui", "spaces", "machines", "outside"])
            ws_send(socket, json_encode({"t": "all", "sessions": sessions(), "spaces": spaces_view(), "machines": machines_view()}))
            ws_send(socket, json_encode({"t": "outside", "list": state_get("outside", [])}))
            while true
                let ev be select({"ui": socket, "bus": sub}, 30)
                when ev != nothing and ev["name"] == "ui"
                    when ev["type"] == "close"
                        stop
                otherwise when ev != nothing and ev["topic"] == "outside"
                    ws_send(socket, json_encode({"t": "outside", "list": state_get("outside", [])}))
                otherwise when ev != nothing and ev["topic"] == "machines"
                    ws_send(socket, json_encode({"t": "machines", "machines": machines_view()}))
                otherwise when ev != nothing and ev["topic"] == "spaces"
                    ws_send(socket, json_encode({"t": "spaces", "spaces": spaces_view()}))
                otherwise when ev != nothing and ev["topic"] == "ui"
                    ws_send(socket, json_encode({"t": "show", "ref": ev["data"]["ref"]}))
                otherwise when ev != nothing
                    ws_send(socket, json_encode({"t": "one", "session": ev["data"]}))

    -- a window on one session; closing it detaches, never kills
    route "GET /api/sessions/:ref/attach" requires auth
        timeout none
        socket
            let s be find_session(params.ref)
            when s == nothing
                ws_send(socket, json_encode({"t": "error", "error": "no session " + params.ref}))
                stop
            let sid be s["id"]
            let out be bus_subscribe("out." + sid, {"max_queue": 8192, "on_full": "drop_oldest"})
            let me be token(16)
            let base be -1
            when s["status"] != "running"
                ws_send(socket, json_encode({"t": "o", "d": state_get("tail:" + sid, "")}))
                ws_send(socket, json_encode({"t": "exit", "code": s["exit_code"]}))
            otherwise
                bus_publish("in." + sid, {"t": "snap", "to": me})
            while true
                let ev be select({"ui": socket, "out": out}, 30)
                when ev != nothing and ev["name"] == "ui"
                    when ev["type"] == "close"
                        stop
                    let m be clean_input(json_decode(ev["data"], nothing))
                    when m != nothing
                        bus_publish("in." + sid, m)
                otherwise when ev != nothing
                    let m be ev["data"]
                    when m["t"] == "snap"
                        when m["to"] == me
                            set base to m["s"]
                            ws_send(socket, json_encode({"t": "o", "d": m["d"]}))
                    otherwise when m["t"] == "o"
                        -- before the snapshot, output is already inside it
                        when base >= 0 and m["s"] > base
                            ws_send(socket, json_encode({"t": "o", "d": m["d"]}))
                    otherwise when m["t"] == "exit"
                        ws_send(socket, json_encode(m))

-- the links to the other machines open again with the daemon
cron_after(1, start_links)
-- and the agents that run outside Atril are looked for now and then
cron_after(3, refresh_outside)
cron_every(20, refresh_outside)

print("atril: listening on http://127.0.0.1:" + text(PORT) + " — key in ~/.atril/daemon.json")
when not BACKGROUND
    window.open_url("http://127.0.0.1:" + text(PORT) + "/#t=" + TOKEN)
