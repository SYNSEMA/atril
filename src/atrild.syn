-- atrild.syn — the Atril daemon: owns the terminals of this machine. It is also what the Start menu
-- opens: started with no argument it opens the window too; when another daemon already answers, it
-- only shows that one's window and ends before listening. `atrild --background` never opens a window
-- (sign-in, `atr up`).
--
-- Every session is a Synsema agent that owns one pseudo-terminal. A window that attaches only
-- subscribes to the session's output on the bus and publishes keys to it, so closing the window
-- detaches: the program keeps running until it exits by itself, someone presses Ctrl-C inside it,
-- or someone kills it on purpose (`atr kill`, or the menu of the sidebar).
--
--   bus  in.<id>    what reaches a session: {t: "i", d: keys} | {t: "r", cols, rows} | {t: "snap", to} | {t: "kill"}
--   bus  out.<id>   what a session says:    {t: "o", s: seq, d: text} | {t: "snap", s, d, to} | {t: "exit", code}
--   bus  sessions   the metadata of a session changed (the sidebar listens)
--   state sess:<id> the metadata of each session, for listing
--
-- Security (v0.1, one machine):
--   - it listens on 127.0.0.1 only: from another computer there is no port to find
--   - every route but the static UI needs the token written at start to ~/.atril/daemon.json
--     (Authorization: Bearer, or the HttpOnly SameSite=Strict cookie the UI gets at /api/login)
--   - Host must be 127.0.0.1 or localhost (DNS rebinding) on any port, so an SSH tunnel
--     (`ssh -L 7172:127.0.0.1:7171 vps`) works; Origin, when sent, must be exactly that host and
--     port (a web page you visit cannot open a socket to your terminals)

require serve(7171)
require exec
require time
require random
require stdout
require env("COMPUTERNAME")
require env("HOSTNAME")
require env("SHELL")
require env("USERPROFILE")
require env("HOME")
require file.write("~/.atril/*")
require file.read          -- a space's .git/HEAD, wherever the project lives (its shells can read it anyway)
require net("127.0.0.1:7171")

use "./window.syn" as window

let PORT be 7171
let TOKEN be token(32)
let KEEP be 524288          -- characters of scrollback each session keeps for a window that attaches
let MACHINE be env("COMPUTERNAME", env("HOSTNAME", "this computer"))
let HOME be env("USERPROFILE", env("HOME", "."))

let BACKGROUND be length(args()) > 0 and args()[0] == "--background"

-- the daemon that already answers on this machine, with its key, or nothing
task running_daemon()
    try
        let c be json_decode(read_file("~/.atril/daemon.json"))
        let r be http_get("http://127.0.0.1:" + text(PORT) + "/api/info", {"Authorization": "Bearer " + c["token"]}, nothing, 2)
        when ok of r
            give c
    recover e
        give nothing
    give nothing

let OTHER be running_daemon()
when OTHER != nothing
    when not BACKGROUND
        let h be {"Authorization": "Bearer " + OTHER["token"]}
        let shown be false
        try
            set shown to (json of http_post("http://127.0.0.1:" + text(PORT) + "/api/show", {}, h, 3))["shown"]
        recover e
            set shown to false
        when not shown
            window.open_url("http://127.0.0.1:" + text(PORT) + "/#t=" + OTHER["token"])
    -- nothing to serve: end here. Under serve, exit() ends the program with an error line, which this
    -- console-less binary never shows
    exit(0)

write_file("~/.atril/daemon.json", json_encode({"port": PORT, "token": TOKEN, "machine": MACHINE}))

-- the shell a new tab opens when nothing else is asked for
task default_shell()
    when platform()["os"] == "windows"
        give {"cmd": "powershell", "args": ["-NoLogo"]}
    give {"cmd": env("SHELL", "bash"), "args": ["-l"]}

-- what runs in it, from the program's name: the sidebar groups and marks agents by it
task kind_of(cmd)
    let file be lower(regex_replace(cmd, "^.*[\\\\/]", ""))
    let base be regex_replace(file, "\\.(exe|cmd|bat|ps1)$", "")
    each k in ["claude", "codex", "opencode", "gemini", "aider", "goose", "amp", "cursor-agent", "ollama"]
        when base == k
            give k
    give "shell"

-- an agent started inside a shell names itself in the title ("✳ Claude Code"): then the session is that agent
task kind_from_title(title)
    let t be lower(text(title))
    each pair in [["claude code", "claude"], ["codex", "codex"], ["opencode", "opencode"], ["gemini", "gemini"], ["aider", "aider"], ["goose", "goose"]]
        when contains(t, pair[0])
            give pair[1]
    give nothing

-- the last terminal title in a chunk of output (OSC 0 or 2), or nothing
task title_in(chunk)
    let found be regex_find_all(chunk, "\u001b\\][02];[^\u0007\u001b]*(\u0007|\u001b\\\\)")
    when length(found) == 0
        give nothing
    let last be found[length(found) - 1]
    give regex_replace(regex_replace(last, "^\u001b\\][02];", ""), "(\u0007|\u001b\\\\)$", "")

-- ---- spaces: the folders sessions run in, each with its git branch

-- one spelling per folder: / separators, no trailing /, case-blind on Windows
task space_key(path)
    let p be regex_replace(replace(text(path), "\\", "/"), "/+$", "")
    give when platform()["os"] == "windows" then lower(p) otherwise p

-- the branch of the repository that holds dir (looking up its parents), or nothing
task git_branch(dir)
    let d be regex_replace(replace(text(dir), "\\", "/"), "/+$", "")
    let depth be 0
    while depth < 40
        let g be d + "/.git"
        let info be file_info(g)
        when info["exists"]
            let gitdir be g
            when not info["is_dir"]
                -- a worktree or a submodule: .git is a file saying where the repository is
                set gitdir to trim(replace(read_file(g), "gitdir:", ""))
                when not regex_find_all(gitdir, "^([A-Za-z]:)?/")
                    set gitdir to d + "/" + gitdir
            try
                let head be trim(read_file(gitdir + "/HEAD"))
                when starts_with(head, "ref: refs/heads/")
                    give slice(head, 16)
                give slice(head, 0, 7)
            recover e
                give nothing
        let up be regex_replace(d, "/[^/]*$", "")
        when up == d or up == ""
            give nothing
        set d to up
        set depth to depth + 1
    give nothing

-- the folders inside path, for the picker: hidden and system folders left out, repositories marked
task list_dirs(path)
    let base be regex_replace(replace(text(path), "\\", "/"), "/+$", "")
    when base == ""
        set base to replace(HOME, "\\", "/")
    let dir be when regex_find_all(base, "^[A-Za-z]:$") then base + "/" otherwise base
    let prefix be when ends_with(dir, "/") then dir otherwise dir + "/"
    let out be []
    each e in list_dir(dir)
        when e["is_dir"] and not starts_with(e["name"], ".") and not starts_with(e["name"], "$") and e["name"] != "node_modules" and e["name"] != "System Volume Information" and length(out) < 500
            let child be prefix + e["name"]
            set out to out + [{"name": e["name"], "path": child, "branch": (when file_info(child + "/.git")["exists"] then git_branch(child) otherwise nothing)}]
    let parent be regex_replace(base, "/[^/]*$", "")
    give {"path": dir, "parent": (when parent == base or parent == "" then nothing otherwise parent), "branch": git_branch(dir), "dirs": out}

-- repositories near home, the most recently touched first: what "new" offers before you browse
task suggestions()
    let h be replace(HOME, "\\", "/")
    let seen be []
    let found be []
    each root in [h, h + "/Desktop", h + "/OneDrive/Desktop", h + "/Documents", h + "/Projects", h + "/code", h + "/dev", h + "/src", h + "/source/repos", h + "/repos", h + "/git", h + "/work"]
        when file_info(root)["is_dir"] and space_key(root) not in seen
            set seen to seen + [space_key(root)]
            try
                each e in list_dir(root)
                    let child be root + "/" + e["name"]
                    when e["is_dir"] and not starts_with(e["name"], ".") and file_info(child + "/.git")["exists"] and space_key(child) not in seen
                        set seen to seen + [space_key(child)]
                        let touched be file_info(child + "/.git/index")["modified"]
                        set found to found + [{"name": e["name"], "path": child, "branch": git_branch(child), "touched": (when touched == nothing then 0 otherwise touched)}]
            recover e
                set seen to seen
    give slice(sort_by(found, (r) => r["touched"], desc = true), 0, 40)

task spaces_view()
    let out be []
    each sp in state_get("spaces", [])
        let name be regex_replace(regex_replace(replace(sp["path"], "\\", "/"), "/+$", ""), "^.*/", "")
        set out to out + [{"key": sp["key"], "path": sp["path"], "name": (when name == "" then sp["path"] otherwise name), "branch": git_branch(sp["path"])}]
    give out

task add_space(path)
    let key be space_key(path)
    let all be state_get("spaces", [])
    each sp in all
        when sp["key"] == key
            give key
    state_set("spaces", all + [{"key": key, "path": path}])
    bus_publish("spaces", {"changed": key})
    give key

task publish_meta(meta)
    state_set("sess:" + meta["id"], meta)
    bus_publish("sessions", meta)

-- one session: one pseudo-terminal, kept alive whoever is watching
agent Session
    require exec
    require time
    let p be proc_spawn(cmd, args, {"pty": true, "cols": cols, "rows": rows, "cwd": cwd})
    let inbox be bus_subscribe("in." + sid)
    let meta be {"id": sid, "name": name, "cmd": cmd, "args": args, "cwd": cwd, "space": space_key(cwd), "kind": kind_of(cmd),
        "pid": proc_stats(p)["pid"], "machine": MACHINE, "started": now(), "status": "running",
        "activity": "working", "title": nothing, "exit_code": nothing, "bell": false}
    publish_meta(meta)
    let seq be 0
    let buf be ""
    let last_out be now()
    while true
        let ev be select({"p": p, "in": inbox}, 1)
        when ev == nothing
            -- quiet for 3 s: an agent waiting for you, or a shell at its prompt
            when meta["activity"] == "working" and now() - last_out > 3
                set meta["activity"] to "idle"
                publish_meta(meta)
        otherwise when ev["name"] == "p"
            when ev["type"] == "exit"
                set meta["status"] to "exited"
                set meta["activity"] to "idle"
                set meta["exit_code"] to ev["data"]["exit_code"]
                set meta["ended"] to now()
                state_set("tail:" + sid, slice(buf, -65536))
                publish_meta(meta)
                bus_publish("out." + sid, {"t": "exit", "code": ev["data"]["exit_code"]})
                stop
            let chunk be ev["data"]
            set seq to seq + 1
            set buf to buf + chunk
            when length(buf) > KEEP * 2
                set buf to slice(buf, length(buf) - KEEP)
            set last_out to now()
            bus_publish("out." + sid, {"t": "o", "s": seq, "d": chunk})
            let changed be meta["activity"] != "working"
            set meta["activity"] to "working"
            let t be title_in(chunk)
            when t != nothing and t != meta["title"]
                set meta["title"] to t
                let k be kind_from_title(t)
                set meta["kind"] to (when k != nothing then k otherwise kind_of(cmd))
                set changed to true
            -- a bell outside a title: the program asks for attention
            when not meta["bell"] and contains(regex_replace(chunk, "\u001b\\][^\u0007]*\u0007", ""), "\u0007")
                set meta["bell"] to true
                set changed to true
            when changed
                publish_meta(meta)
        otherwise
            let m be ev["data"]
            when m["t"] == "i"
                proc_send(p, m["d"])
                when meta["bell"]
                    set meta["bell"] to false
                    publish_meta(meta)
            otherwise when m["t"] == "r"
                proc_resize(p, m["cols"], m["rows"])
            otherwise when m["t"] == "snap"
                bus_publish("out." + sid, {"t": "snap", "s": seq, "d": buf, "to": m["to"]})
            otherwise when m["t"] == "kill"
                proc_kill(p)
            otherwise when m["t"] == "name"
                set meta["name"] to m["name"]
                publish_meta(meta)

-- what a window may send to a session, and nothing else: keys, or a new size
task clean_input(m)
    when type_of(m) != "map"
        give nothing
    when get(m, "t") == "i" and type_of(get(m, "d")) == "text"
        give {"t": "i", "d": m["d"]}
    when get(m, "t") == "r"
        let c be int(get(m, "cols"), fallback = 0)
        let r be int(get(m, "rows"), fallback = 0)
        when c >= 2 and c <= 1000 and r >= 2 and r <= 500
            give {"t": "r", "cols": c, "rows": r}
    give nothing

task sessions()
    let all be state_all()
    let out be []
    each k in keys(all)
        when starts_with(k, "sess:")
            set out to out + [all[k]]
    give sort_by(out, (s) => s["started"])

-- a session by id, name or pid
-- several with one name (a session restarted): the running one, else the newest
task find_session(ref)
    let found be nothing
    each s in sessions()
        when s["id"] == ref or s["name"] == ref or text(s["pid"]) == ref
            when found == nothing or s["status"] == "running" or found["status"] != "running"
                set found to s
    give found

-- cookies are per host, not per port: a tunnel to another machine on 127.0.0.1:7172 keeps its own
task cookie_name(host)
    give "atril_" + regex_replace(host, "^.*:", "")

-- who may talk to the daemon: same machine, same origin, the token
task check(tok, request)
    let h be request.headers
    let host be text(get(h, "host", ""))
    when not regex_find_all(host, "^(127\\.0\\.0\\.1|localhost)(:[0-9]+)?$")
        give nothing
    when get(h, "origin") != nothing and get(h, "origin") != "http://" + host
        give nothing
    let given be tok
    when given == nothing or given == ""
        set given to get(request.cookies, cookie_name(host))
    when given == nothing or not constant_time_eq(given, TOKEN)
        give nothing
    give {"name": "owner"}

let LOGIN_PAGE be "<!doctype html><meta charset=utf-8><title>Atril</title><body style='background:#0c0c0d;color:#9a9aa2;font:14px ui-monospace,monospace;padding:40px'>Open Atril with <b style='color:#e6e6ea'>atr open</b> — it brings the key of this computer.</body>"

serve on 7171
    bind "127.0.0.1"
    auth with check
    static "./ui"

    route "GET /api/hello"
        give respond(LOGIN_PAGE, "text/html")

    route "POST /api/login" requires auth
        give set_cookie({"ok": true, "machine": MACHINE}, cookie_name(text(get(request.headers, "host", ""))), TOKEN, {"secure": false, "same_site": "Strict", "http_only": true})

    -- `atr down`: every session ends with the daemon
    route "POST /api/shutdown" requires auth
        shutdown("atr down")
        give {"ok": true}

    -- `atr open` with a window already open: show it there instead of opening another one
    route "POST /api/show" requires auth
        let b be json of request
        let ref be when b == nothing then nothing otherwise get(b, "ref")
        give {"shown": bus_publish("ui", {"ref": ref}) > 0}

    route "GET /api/dirs" requires auth
        try
            give list_dirs(get(query, "path", ""))
        recover e
            give fail(400, "cannot open that folder: " + text(e))

    route "GET /api/dirs/suggest" requires auth
        give {"home": HOME, "repos": suggestions()}

    -- a title for a session: what you will do there, to remember it and to find it
    route "POST /api/sessions/:ref/rename" requires auth
        let s be find_session(params.ref)
        when s == nothing
            give not_found("no session " + params.ref)
        let b be json of request
        let nm be trim(text(when b == nothing then "" otherwise get(b, "name", "")))
        when nm == "" or length(nm) > 80 or regex_find_all(nm, "[\u0000-\u001f]")
            give fail(400, "a title is 1 to 80 characters, on one line")
        when s["status"] == "running"
            bus_publish("in." + s["id"], {"t": "name", "name": nm})
        otherwise
            set s["name"] to nm
            publish_meta(s)
        give {"ok": true, "id": s["id"], "name": nm}

    route "GET /api/spaces" requires auth
        give spaces_view()

    -- a new space: a folder that exists
    route "POST /api/spaces" requires auth
        let b be json of request
        let path be when b == nothing then "" otherwise text(get(b, "path", ""))
        when path == "" or not file_info(path)["is_dir"]
            give fail(400, "no such folder: " + path)
        give {"key": add_space(path)}

    -- forget a space with nothing running in it
    route "POST /api/spaces/forget" requires auth
        let b be json of request
        let key be when b == nothing then "" otherwise space_key(get(b, "key", ""))
        each s in sessions()
            when get(s, "space") == key and s["status"] == "running"
                give fail(400, "something is still running in that space")
        state_set("spaces", where(state_get("spaces", []), (sp) => sp["key"] != key))
        bus_publish("spaces", {"changed": key})
        give {"ok": true}

    route "GET /api/info" requires auth
        give {"machine": MACHINE, "os": platform()["os"], "version": "0.1.0"}

    route "GET /api/sessions" requires auth
        give sessions()

    route "POST /api/sessions" requires auth
        let b be json of request
        when b == nothing
            set b to {}
        let sh be default_shell()
        let cmd be get(b, "cmd")
        let args be get(b, "args")
        when cmd == nothing or cmd == ""
            set cmd to sh["cmd"]
            set args to sh["args"]
        when args == nothing
            set args to []
        let n be state_incr("next_id")
        let sid be "s" + text(n)
        let nm be get(b, "name")
        when nm == nothing or nm == ""
            set nm to kind_of(cmd) + "-" + text(n)
        let cwd be get(b, "cwd")
        when cwd == nothing or cwd == ""
            set cwd to HOME
        add_space(cwd)
        let cols be int(get(b, "cols"), fallback = 120)
        let rows be int(get(b, "rows"), fallback = 32)
        spawn Session with sid = sid, name = nm, cmd = cmd, args = args, cwd = cwd, cols = cols, rows = rows
        -- wait until the agent published itself, so the answer carries the pid
        let tries be 0
        while state_get("sess:" + sid) == nothing and tries < 50
            sleep(0.05)
            set tries to tries + 1
        give state_get("sess:" + sid, {"id": sid, "name": nm, "status": "starting"})

    route "POST /api/sessions/:ref/kill" requires auth
        let s be find_session(params.ref)
        when s == nothing
            give not_found("no session " + params.ref)
        bus_publish("in." + s["id"], {"t": "kill"})
        give {"ok": true, "id": s["id"]}

    route "DELETE /api/sessions/:ref" requires auth
        let s be find_session(params.ref)
        when s == nothing
            give not_found("no session " + params.ref)
        when s["status"] == "running"
            give fail(400, "session " + s["id"] + " is still running: kill it first")
        state_delete("sess:" + s["id"])
        state_delete("tail:" + s["id"])
        bus_publish("sessions", {"id": s["id"], "status": "removed"})
        give {"ok": true}

    -- the sidebar: every change of every session
    route "GET /api/events" requires auth
        timeout none
        socket
            let sub be bus_subscribe(["sessions", "ui", "spaces"])
            ws_send(socket, json_encode({"t": "all", "sessions": sessions(), "spaces": spaces_view()}))
            while true
                let ev be select({"ui": socket, "bus": sub}, 30)
                when ev != nothing and ev["name"] == "ui"
                    when ev["type"] == "close"
                        stop
                otherwise when ev != nothing and ev["topic"] == "spaces"
                    ws_send(socket, json_encode({"t": "spaces", "spaces": spaces_view()}))
                otherwise when ev != nothing and ev["topic"] == "ui"
                    ws_send(socket, json_encode({"t": "show", "ref": ev["data"]["ref"]}))
                otherwise when ev != nothing
                    ws_send(socket, json_encode({"t": "one", "session": ev["data"]}))

    -- a window on one session; closing it detaches, never kills
    route "GET /api/sessions/:ref/attach" requires auth
        timeout none
        socket
            let s be find_session(params.ref)
            when s == nothing
                ws_send(socket, json_encode({"t": "error", "error": "no session " + params.ref}))
                stop
            let sid be s["id"]
            let out be bus_subscribe("out." + sid, {"max_queue": 8192, "on_full": "drop_oldest"})
            let me be token(16)
            let base be -1
            when s["status"] != "running"
                ws_send(socket, json_encode({"t": "o", "d": state_get("tail:" + sid, "")}))
                ws_send(socket, json_encode({"t": "exit", "code": s["exit_code"]}))
            otherwise
                bus_publish("in." + sid, {"t": "snap", "to": me})
            while true
                let ev be select({"ui": socket, "out": out}, 30)
                when ev != nothing and ev["name"] == "ui"
                    when ev["type"] == "close"
                        stop
                    let m be clean_input(json_decode(ev["data"], nothing))
                    when m != nothing
                        bus_publish("in." + sid, m)
                otherwise when ev != nothing
                    let m be ev["data"]
                    when m["t"] == "snap"
                        when m["to"] == me
                            set base to m["s"]
                            ws_send(socket, json_encode({"t": "o", "d": m["d"]}))
                    otherwise when m["t"] == "o"
                        -- before the snapshot, output is already inside it
                        when base >= 0 and m["s"] > base
                            ws_send(socket, json_encode({"t": "o", "d": m["d"]}))
                    otherwise when m["t"] == "exit"
                        ws_send(socket, json_encode(m))

print("atril: listening on http://127.0.0.1:" + text(PORT) + " — key in ~/.atril/daemon.json")
when not BACKGROUND
    window.open_url("http://127.0.0.1:" + text(PORT) + "/#t=" + TOKEN)
